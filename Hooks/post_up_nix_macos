#!/usr/bin/env bash
# Post-up hook for nix_macos group
# Ensures machine.nix exists after deployment

set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}✓${NC} Nix configuration deployed"

# Check if machine.nix exists in the deployed location
MACHINE_CONFIG="$HOME/.config/nix/machine.nix"

if [ ! -f "$MACHINE_CONFIG" ]; then
    echo -e "${YELLOW}!${NC} machine.nix not found, generating..."

    # Try to use generate-machine-config if available
    if command -v generate-machine-config &> /dev/null; then
        generate-machine-config
    else
        echo -e "${BLUE}→${NC} Please run: generate-machine-config"
        echo -e "${BLUE}→${NC} Or manually create: $MACHINE_CONFIG"
    fi
else
    echo -e "${BLUE}→${NC} machine.nix exists at: $MACHINE_CONFIG"
fi
