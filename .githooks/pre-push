#!/usr/bin/env bash
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
	echo "gitleaks is not installed; install it with Nix before pushing." >&2
	echo "Run: rebuild" >&2
	exit 1
fi

zero_sha="0000000000000000000000000000000000000000"
failed=0
checked=0

while read -r local_ref local_sha remote_ref remote_sha; do
	if [ -z "${local_ref:-}" ]; then
		continue
	fi

	# Deleting a remote ref does not introduce new commits to scan.
	if [ "$local_sha" = "$zero_sha" ]; then
		continue
	fi

	if [ "$remote_sha" = "$zero_sha" ]; then
		# New branches should only scan commits introduced by this branch. Scanning
		# the full reachable history can fail on legacy findings that already exist
		# on the default branch and are unrelated to the push.
		default_remote_ref="refs/remotes/origin/HEAD"
		if git show-ref --verify --quiet "$default_remote_ref"; then
			log_opts="$default_remote_ref..$local_sha"
		else
			log_opts="$local_sha --not --remotes"
		fi
	else
		log_opts="$remote_sha..$local_sha"
	fi

	echo "==> Running gitleaks for $local_ref -> $remote_ref ($log_opts)"
	checked=1

	if ! gitleaks git --redact --verbose --log-opts="$log_opts" .; then
		failed=1
	fi
done

if [ "$checked" -eq 0 ]; then
	echo "==> Running gitleaks on the working tree"
	if ! gitleaks dir --redact --verbose .; then
		failed=1
	fi
fi

if [ "$failed" -ne 0 ]; then
	echo "gitleaks found potential secrets. Push blocked." >&2
	exit 1
fi

echo "gitleaks pre-push check passed."
