# Nix build outputs and artifacts
Configs/nix_macos/.config/nix/result
Configs/nix_macos/.config/nix/.devenv/
Configs/nix_macos/.config/nix/.devenv.flake.nix
**/result
**/result-*
**/flake.lock
.direnv/
**/.direnv/
.nix-defexpr/
.nix-channels

# Backup directories and files (timestamped backups)
*.backup.*
**/*.backup.*
*.yazelix-backup
**/*.yazelix-backup

# macOS specific files
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor temporary files
*.swp
*.swo
*~
.*.sw?

# Helix runtime state (managed by tuckr, not tracked)
**/.helix/recent-files.txt
**/.helix/*.log
**/debug.log

# Cache and state directories
.cache/
.local/state/
**/.devenv/
**/.devenv.flake.nix

# Log files
logs/
*.log

# User-specific configuration (should not be in dotfiles)
**/yazelix.toml
**/yazelix.nix
**/machine.nix

# Environment files with secrets
.env
.env.*
*.env
**/.env
**/.env.*
# But allow .example files to be tracked
!.env.*.example
!**/.env.*.example

# Build artifacts and dependencies
# Rust
**/target/
Cargo.lock

# Node.js / JavaScript / TypeScript
node_modules/
**/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/
.yarn/
.pnpm-store/
.pnpm-debug.log

# Build outputs
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
.nuxt/
.output/
.vercel/
.turbo/

# Python
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# Go
go.sum
vendor/

# Java
*.class
*.jar
*.war
.gradle/
build.gradle.kts

# IDE and editors
.vscode/
.idea/
*.iml

# Temporary files
*.tmp
*.temp
.*.tmp
