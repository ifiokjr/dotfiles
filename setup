#!/usr/bin/env bash
#
# Dotfiles Setup Script
#
# This script sets up your development environment by:
# 1. Installing Determinate Nix (if not present)
# 2. Cloning the dotfiles repository (if not present)
# 3. Setting up Tuckr symlinks
# 4. Deploying configuration groups
#
# Usage:
#   Local:  ./setup.sh [options]
#   Remote: curl -fsSL https://raw.githubusercontent.com/ifiokjr/dotfiles/refs/heads/main/setup.sh | bash
#
# Options:
#   --cwd PATH          Clone dotfiles to PATH (default: current directory or ~/Developer/.dotfiles)
#   --groups GROUPS     Deploy specific groups (comma-separated, otherwise deploys all)
#   --skip-nix          Skip Nix installation (use if already installed)
#   --no-confirm        Run headlessly without interactive prompts
#   --help              Show this help message

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Configuration
DOTFILES_REPO="https://github.com/ifiokjr/dotfiles.git"
DEFAULT_DOTFILES_DIR="$HOME/Developer/.dotfiles"
DOTFILES_DIR=""
DEPLOY_GROUPS=""
SKIP_NIX=false
NO_CONFIRM=false

# Track what we install for cleanup
INSTALLED_GIT=false
INSTALLED_TUCKR=false
INSTALLED_NUSHELL=false
DEPLOY_FAILED=false

# Print functions
print_header() {
    echo -e "${BOLD}${CYAN}==>${NC} ${BOLD}$1${NC}"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_info() {
    echo -e "${BLUE}→${NC} $1"
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --cwd)
                DOTFILES_DIR="$2"
                shift 2
                ;;
            --groups)
                DEPLOY_GROUPS="$2"
                shift 2
                ;;
            --skip-nix)
                SKIP_NIX=true
                shift
                ;;
            --no-confirm)
                NO_CONFIRM=true
                shift
                ;;
            --help)
                sed -n '2,16p' "$0" | sed 's/^# //'
                exit 0
                ;;
            *)
                print_error "Unknown option: $1"
                echo "Run with --help for usage information"
                exit 1
                ;;
        esac
    done

    # Set default if not specified
    if [ -z "$DOTFILES_DIR" ]; then
        DOTFILES_DIR="$DEFAULT_DOTFILES_DIR"
    fi
}

# Detect platform
detect_platform() {
    case "$(uname -s)" in
        Darwin*)
            PLATFORM="macos"
            ;;
        Linux*)
            PLATFORM="linux"
            ;;
        CYGWIN*|MINGW32*|MINGW64*|MINGW*|MSYS*)
            PLATFORM="windows"
            ;;
        FreeBSD*|OpenBSD*|NetBSD*)
            PLATFORM="bsd"
            ;;
        *)
            print_error "Unknown platform: $(uname -s)"
            exit 1
            ;;
    esac
    print_info "Platform detected: $PLATFORM"
}

# Check if we're running from within the repo
check_if_in_repo() {
    if [ -f "$(dirname "$0")/setup-tuckr-symlink.sh" ] && [ -d "$(dirname "$0")/Configs" ]; then
        DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"
        print_info "Running from within dotfiles repository: $DOTFILES_DIR"
        return 0
    fi
    return 1
}

# Install Nix using Determinate Systems installer
install_nix() {
    if [ "$SKIP_NIX" = true ]; then
        print_info "Skipping Nix installation (--skip-nix flag provided)"
        return 0
    fi

    if command -v nix &> /dev/null; then
        print_success "Nix is already installed"
        return 0
    fi

    print_header "Installing Determinate Nix"

    local nix_install_args=("install")
    # Linux containers lack systemd; use root-only nix install.
    # Only applies to Linux — macOS uses launchd, not systemd.
    if [ "$(uname -s)" = "Linux" ] && [ ! -d /run/systemd/system ]; then
        nix_install_args+=("linux" "--init" "none")
    fi
    if [ "$NO_CONFIRM" = true ]; then
        nix_install_args+=("--no-confirm")
    fi

    if ! curl -fsSL https://install.determinate.systems/nix | sh -s -- "${nix_install_args[@]}"; then
        print_error "Failed to install Nix"
        exit 1
    fi

    # Source nix
    if [ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
        # shellcheck disable=SC1091
        . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
    fi

    # Configure GitHub access token if available to avoid API rate limits when
    # fetching nixpkgs. GitHub Actions provides GITHUB_TOKEN automatically.
    if [ -n "${GITHUB_TOKEN:-}" ]; then
        local nix_conf_dir="$HOME/.config/nix"
        mkdir -p "$nix_conf_dir"
        if ! grep -q "access-tokens" "$nix_conf_dir/nix.conf" 2>/dev/null; then
            echo "access-tokens = github.com=$GITHUB_TOKEN" >> "$nix_conf_dir/nix.conf"
            print_info "Configured GitHub access token for nix"
        fi
    fi

    # Root-only nix (--init none) puts binaries in /nix/var/nix/profiles/default/bin
    # which isn't in the default system PATH. Symlink them to /usr/local/bin so all
    # processes (including those spawned by sudo) can find nix, nix-env, etc.
    if [ "$(uname -s)" = "Linux" ] && [ ! -d /run/systemd/system ] && [ -d /nix/var/nix/profiles/default/bin ]; then
        print_info "Symlinking nix binaries to /usr/local/bin for system-wide access"
        for f in /nix/var/nix/profiles/default/bin/*; do
            sudo ln -sf "$f" /usr/local/bin/
        done
    fi

    print_success "Nix installed successfully"
}

# Check if a command exists
command_exists() {
    command -v "$1" &> /dev/null
}

# Run nix commands, using sudo when nix was installed root-only (--init none).
# Nix binaries are symlinked to /usr/local/bin so PATH isn't needed.
# HOME is preserved so profile installs go to the calling user's profile.
run_nix() {
    if [ "$(uname -s)" = "Linux" ] && [ ! -d /run/systemd/system ] && [ "$(id -u)" -ne 0 ]; then
        sudo HOME="$HOME" nix "$@"
    else
        nix "$@"
    fi
}

# Install git via nix profile if needed
install_git() {
    if command_exists git; then
        print_success "Git is already available"
        return 0
    fi

    print_header "Installing git temporarily"

    if ! run_nix profile add nixpkgs#git; then
        print_error "Failed to install git"
        exit 1
    fi

    INSTALLED_GIT=true
    print_success "Git installed"
}

# Install tuckr via nix profile if needed
install_tuckr() {
    if command_exists tuckr; then
        print_success "Tuckr is already available"
        return 0
    fi

    print_header "Installing tuckr temporarily"

    if ! run_nix profile add nixpkgs#tuckr; then
        print_error "Failed to install tuckr"
        exit 1
    fi

    INSTALLED_TUCKR=true
    print_success "Tuckr installed"
}

# Install nushell via nix profile if needed (scripts require it)
install_nushell() {
    if command_exists nu; then
        print_success "Nushell is already available"
        return 0
    fi

    print_header "Installing nushell temporarily"

    if ! run_nix profile add nixpkgs#nushell; then
        print_error "Failed to install nushell"
        exit 1
    fi

    INSTALLED_NUSHELL=true
    print_success "Nushell installed"
}

# Clone the dotfiles repository
clone_dotfiles() {
    if [ -d "$DOTFILES_DIR/.git" ]; then
        print_success "Dotfiles repository already exists at $DOTFILES_DIR"
        return 0
    fi

    print_header "Cloning dotfiles repository"
    print_info "Destination: $DOTFILES_DIR"

    # Create parent directory if it doesn't exist
    mkdir -p "$(dirname "$DOTFILES_DIR")"

    if ! git clone "$DOTFILES_REPO" "$DOTFILES_DIR"; then
        print_error "Failed to clone dotfiles repository"
        exit 1
    fi

    print_success "Dotfiles cloned successfully"
}

# Setup Tuckr symlink
setup_tuckr_symlink() {
    print_header "Setting up Tuckr symlink"

    if ! "$DOTFILES_DIR/setup-tuckr-symlink.sh" "$DOTFILES_DIR"; then
        print_error "Failed to setup Tuckr symlink"
        exit 1
    fi

    print_success "Tuckr symlink configured"
}

# Ask user for confirmation
ask_yes_no() {
    local prompt="$1"
    local response

    while true; do
        read -rp "$(echo -e "${CYAN}?${NC} $prompt [y/N]: ")" response
        case "$response" in
            [Yy]|[Yy][Ee][Ss])
                return 0
                ;;
            [Nn]|[Nn][Oo]|"")
                return 1
                ;;
            *)
                print_warning "Please answer yes or no"
                ;;
        esac
    done
}

# Deploy a single group with automatic --force fallback on conflict.
# Usage: tuckr_deploy <tuckr_binary> <group> [set]
# Pass "set" as $3 to use `tuckr set` (runs hooks) instead of `tuckr add`.
# Returns:
#   0 on success
#   1 on failure
#   2 from run_tuckr_command when a hook failed (treated as non-retriable)
run_tuckr_command() {
    local tuckr_bin="$1"
    local mode="$2"
    local group="$3"
    local force="${4:-false}"
    local out_file
    local rc=0

    out_file="$(mktemp)"

    if [ "$force" = true ]; then
        if echo y | "$tuckr_bin" "$mode" --force "$group" 2>&1 | tee "$out_file"; then
            rc=0
        else
            rc=$?
        fi
    else
        if "$tuckr_bin" "$mode" "$group" 2>&1 | tee "$out_file"; then
            rc=0
        else
            rc=$?
        fi
    fi

    # Tuckr can return success even when hooks fail. Treat that as a hard failure.
    if grep -q "Failed to hook" "$out_file"; then
        # Docker CI builds can run setup before the nix daemon is started.
        # In that environment, the nix post-hook may fail during bootstrap even
        # though the later explicit rebuild step succeeds. Allow this only when
        # explicitly opted in.
        if [ "${SETUP_ALLOW_NIX_HOOK_FAILURE:-false}" = "true" ] && [ "$group" = "nix" ] && [ "$mode" = "set" ]; then
            print_warning "Ignoring nix hook failure due to SETUP_ALLOW_NIX_HOOK_FAILURE=true"
            rm -f "$out_file"
            return 0
        fi

        rm -f "$out_file"
        return 2
    fi

    rm -f "$out_file"
    return "$rc"
}

tuckr_deploy() {
    local tuckr_bin="$1"
    local group="$2"
    local mode="${3:-add}"
    local rc=0

    if run_tuckr_command "$tuckr_bin" "$mode" "$group"; then
        return 0
    else
        rc=$?
    fi

    if [ "$rc" -eq 2 ]; then
        print_error "Hook failed while deploying $group"
        return 1
    fi

    # First attempt failed — retry with --force (handles existing file conflicts).
    # Pipe "y" because tuckr --force still prompts "Are you sure?" interactively.
    print_warning "Retrying $group with --force (existing file conflict)"
    if run_tuckr_command "$tuckr_bin" "$mode" "$group" true; then
        return 0
    else
        rc=$?
    fi

    if [ "$rc" -eq 2 ]; then
        print_error "Hook failed while deploying $group"
    fi

    return 1
}

# Deploy configuration groups
deploy_groups() {
    print_header "Deploying configuration groups"

    cd "$DOTFILES_DIR"

    # Pre-create common parent directories that tuckr needs for symlinking.
    # On a fresh macOS, ~/.config and ~/.local/bin may not exist yet, causing
    # "No such file or directory (os error 2)" when tuckr tries to create
    # symlinks inside them.
    mkdir -p "$HOME/.config"
    mkdir -p "$HOME/.local/bin"

    # Resolve tuckr to its real nix store path. This survives nix profile
    # removal — only the ~/.nix-profile/bin symlink is deleted, the store
    # binary remains. We need this because tuckr is removed from the profile
    # before nix deployment to avoid home-manager conflicts, but is still
    # needed to deploy remaining groups.
    local TUCKR
    TUCKR=$(realpath "$(command -v tuckr)")

    # Groups that have hooks and should use 'tuckr set' instead of 'tuckr add'
    local hook_groups=("nix" "nushell" "claude")

    # Helper: check if a group uses hooks
    has_hook() {
        local group="$1"
        for hg in "${hook_groups[@]}"; do
            [[ "$group" == "$hg" ]] && return 0
        done
        return 1
    }

    # Helper: deploy a group (with hook awareness and --force fallback)
    deploy_one() {
        local group="$1"
        local mode="add"
        has_hook "$group" && mode="set"

        if [ "$mode" = "set" ]; then
            print_info "Deploying $group (with hooks)"
        else
            print_info "Deploying $group"
        fi

        if tuckr_deploy "$TUCKR" "$group" "$mode"; then
            print_success "Deployed $group"
        else
            print_error "Failed to deploy $group"
            DEPLOY_FAILED=true
        fi
    }

    # If specific groups are specified via --groups flag
    if [ -n "$DEPLOY_GROUPS" ]; then
        IFS=',' read -ra GROUPS <<< "$DEPLOY_GROUPS"
        for group in "${GROUPS[@]}"; do
            deploy_one "$group"
        done
        return 0
    fi

    # Get all available groups from Configs directory
    local all_groups=()
    if [ -d "Configs" ]; then
        while IFS= read -r -d '' dir; do
            local group_name
            group_name=$(basename "$dir")
            all_groups+=("$group_name")
        done < <(find Configs -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
    fi

    if [ ${#all_groups[@]} -eq 0 ]; then
        print_warning "No configuration groups found in Configs/"
        return 1
    fi

    print_info "Found ${#all_groups[@]} configuration groups"
    echo ""

    # -----------------------------------------------------------------------
    # Deployment phases (order matters):
    #   1. scripts    — other hooks depend on scripts in ~/.local/bin
    #   2. nix        — installs all tools via darwin-rebuild / home-manager
    #   3. simple     — groups with no ordering constraints (alphabetical)
    #   4. late       — nushell (needs starship/carapace from nix)
    #                   helix  (custom build needs nushell + cargo)
    #                   claude (needs deno for MCP server)
    # -----------------------------------------------------------------------
    local late_groups=("nushell" "helix" "claude")

    is_late() {
        local group="$1"
        for lg in "${late_groups[@]}"; do
            [[ "$group" == "$lg" ]] && return 0
        done
        return 1
    }

    # Phase 1: scripts
    for g in "${all_groups[@]}"; do
        if [[ "$g" == "scripts" ]]; then
            print_info "Deploying scripts (priority)"
            if tuckr_deploy "$TUCKR" scripts add; then
                print_success "Deployed scripts"
            else
                print_error "Failed to deploy scripts"
                DEPLOY_FAILED=true
            fi
            break
        fi
    done

    # Phase 2: nix
    for g in "${all_groups[@]}"; do
        if [[ "$g" == "nix" ]]; then
            echo ""
            if [[ "$PLATFORM" == "macos" ]]; then
                print_header "Nix Darwin Configuration"
                echo -e "${YELLOW}Note:${NC} nix deployment will run 'darwin-rebuild switch' which requires sudo"
            else
                print_header "Nix Home Manager Configuration"
                echo -e "${YELLOW}Note:${NC} nix deployment will run 'home-manager switch'"
            fi
            print_info "This may take several minutes..."
            echo ""

            # Remove temporary nix profile packages before nix deployment.
            # home-manager (or nix-darwin) will install these permanently, but
            # if they're already in the nix profile the activation fails with
            # "An existing package already provides the following file" conflict.
            if [ "$INSTALLED_TUCKR" = true ]; then
                print_info "Removing temporary tuckr to avoid nix profile conflict"
                run_nix profile remove --regex '.*tuckr.*' 2>/dev/null || true
                INSTALLED_TUCKR=false
            fi
            if [ "$INSTALLED_NUSHELL" = true ]; then
                print_info "Removing temporary nushell to avoid nix profile conflict"
                run_nix profile remove --regex '.*nushell.*' 2>/dev/null || true
                INSTALLED_NUSHELL=false
            fi

            if tuckr_deploy "$TUCKR" nix set; then
                print_success "Deployed nix"
            else
                print_error "Failed to deploy nix"
                DEPLOY_FAILED=true
            fi
            break
        fi
    done

    # Phase 3: simple groups (everything except scripts, nix, and late groups)
    for group in "${all_groups[@]}"; do
        [[ "$group" == "scripts" ]] && continue
        [[ "$group" == "nix" ]] && continue
        is_late "$group" && continue

        # Skip platform-specific groups that don't match the current platform
        if [[ "$group" == *_macos ]] && [[ "$PLATFORM" != "macos" ]]; then
            print_info "Skipping $group (macOS-only, current platform: $PLATFORM)"
            continue
        fi
        if [[ "$group" == *_linux ]] && [[ "$PLATFORM" != "linux" ]]; then
            print_info "Skipping $group (Linux-only, current platform: $PLATFORM)"
            continue
        fi

        deploy_one "$group"
    done

    # Phase 4: late groups (in defined order)
    for group in "${late_groups[@]}"; do
        # Verify the group actually exists in Configs/
        local found=false
        for g in "${all_groups[@]}"; do
            [[ "$g" == "$group" ]] && found=true && break
        done
        [[ "$found" == "false" ]] && continue

        # Special handling for helix - offer to install custom build
        if [[ "$group" == "helix" ]]; then
            deploy_one "$group"

            # Ask about custom Helix installation
            echo ""
            print_header "Custom Helix with Steel Plugin System"
            echo -e "${YELLOW}Note:${NC} The helix config has been deployed, but you need the custom Helix binary to use Steel plugins"
            print_info "This will:"
            echo "  • Clone/update the Helix Steel fork (mattwparas/helix)"
            echo "  • Build Helix with Steel plugin support (requires Rust/cargo)"
            echo "  • Install Steel language server and package manager"
            echo "  • This process takes 5-10 minutes"
            echo ""

            if [ "$NO_CONFIRM" = false ] && ask_yes_no "Would you like to install custom Helix with Steel support now?"; then
                print_info "Installing custom Helix..."
                echo ""

                # Check if install:helix:custom script exists
                local helix_install_script="$DOTFILES_DIR/Configs/scripts/.local/bin/install:helix:custom"
                if [ -f "$helix_install_script" ]; then
                    if nu "$helix_install_script"; then
                        print_success "Custom Helix installed successfully"
                        # Verify steel tools are available
                        for tool in forge steel steel-language-server; do
                            if [ -f "$HOME/.local/bin/$tool" ]; then
                                print_success "$tool available at ~/.local/bin/$tool"
                            else
                                print_warning "$tool not found at ~/.local/bin/$tool"
                            fi
                        done
                    else
                        print_warning "Failed to install custom Helix (you can run 'install:helix:custom' manually later)"
                    fi
                else
                    print_warning "install:helix:custom script not found (you can run it manually after setup)"
                fi
            else
                print_info "Skipping custom Helix installation"
                print_info "You can install it later by running: install:helix:custom"
            fi
            echo ""
            continue
        fi

        deploy_one "$group"
    done

    echo ""
    if [ "$DEPLOY_FAILED" = true ]; then
        print_error "Some groups failed to deploy (see errors above)"
        return 1
    fi
    print_success "Configuration deployment complete"
}

# Cleanup temporary packages
cleanup() {
    print_header "Cleaning up"

    if [ "$INSTALLED_TUCKR" = true ]; then
        print_info "Removing tuckr from nix profile"
        run_nix profile remove --regex '.*tuckr.*' || print_warning "Could not remove tuckr (may already be removed)"
    fi

    if [ "$INSTALLED_NUSHELL" = true ]; then
        print_info "Removing nushell from nix profile"
        run_nix profile remove --regex '.*nushell.*' || print_warning "Could not remove nushell (may already be removed)"
    fi

    if [ "$INSTALLED_GIT" = true ]; then
        print_info "Removing git from nix profile"
        run_nix profile remove --regex '.*git.*' || print_warning "Could not remove git (may already be removed)"
    fi

    print_success "Cleanup complete"
}

# Main setup flow
main() {
    echo ""
    echo -e "${BOLD}${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}${CYAN}║                                        ║${NC}"
    echo -e "${BOLD}${CYAN}║      Dotfiles Setup Script             ║${NC}"
    echo -e "${BOLD}${CYAN}║                                        ║${NC}"
    echo -e "${BOLD}${CYAN}╚════════════════════════════════════════╝${NC}"
    echo ""

    parse_args "$@"
    export NO_CONFIRM
    detect_platform

    # Check if we're already in the repo
    if ! check_if_in_repo; then
        # Not in repo, need to clone
        install_nix
        install_git
        clone_dotfiles
    else
        # In repo, may still need Nix and Tuckr
        if ! command_exists nix && [ "$SKIP_NIX" = false ]; then
            install_nix
        fi
    fi

    # Always need tuckr and nushell
    install_tuckr
    install_nushell

    # Setup and deploy
    setup_tuckr_symlink
    local deploy_exit=0
    deploy_groups || deploy_exit=$?

    # Cleanup
    cleanup

    # Exit with failure if any group deployment failed.
    # Avoid printing a success banner in this case.
    if [ "$deploy_exit" -ne 0 ]; then
        echo ""
        print_error "Setup completed with errors"
        exit "$deploy_exit"
    fi

    echo ""
    echo -e "${GREEN}${BOLD}╔════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}${BOLD}║                                        ║${NC}"
    echo -e "${GREEN}${BOLD}║      Setup Complete! 🎉                ║${NC}"
    echo -e "${GREEN}${BOLD}║                                        ║${NC}"
    echo -e "${GREEN}${BOLD}╚════════════════════════════════════════╝${NC}"
    echo ""
    print_info "Your dotfiles have been installed to: $DOTFILES_DIR"
    print_info "Configuration files are now symlinked to your home directory"
    echo ""
    print_header "Next Steps"

    if [ "$PLATFORM" = "macos" ]; then
        echo -e "  ${CYAN}1.${NC} Open a new terminal window"
        echo -e "  ${CYAN}2.${NC} Verify Tuckr status: ${BOLD}tuckr status${NC}"
        echo -e "  ${CYAN}3.${NC} Check configuration: ${BOLD}ls -la ~ | grep '^l'${NC} (shows symlinks)"
    else
        echo -e "  ${CYAN}1.${NC} Restart your terminal"
        echo -e "  ${CYAN}2.${NC} Verify Tuckr status: ${BOLD}tuckr status${NC}"
        echo -e "  ${CYAN}3.${NC} Check configuration: ${BOLD}ls -la ~ | grep '^l'${NC} (shows symlinks)"
    fi

    echo ""
    print_info "For more information, see: $DOTFILES_DIR/README.md"
    echo ""

    # In GitHub Actions, export current PATH entries to GITHUB_PATH so that
    # binaries installed by setup (via home-manager, nix profile, etc.) are
    # available in subsequent workflow steps.
    # Use ${VAR:-} to avoid "unbound variable" errors from set -u.
    if [ -n "${GITHUB_ACTIONS:-}" ] && [ -n "${GITHUB_PATH:-}" ]; then
        print_info "Exporting PATH to GITHUB_PATH for subsequent steps"
        print_info "GITHUB_PATH file: $GITHUB_PATH"
        print_info "Current PATH entries:"
        echo "$PATH" | tr ':' '\n' | while read -r p; do
            echo "  $p"
        done
        {
            echo "$PATH" | tr ':' '\n'
            # Ensure nix profile paths are available even if not yet in PATH
            echo "/etc/profiles/per-user/${USER:-$(whoami)}/bin"
            echo "/run/current-system/sw/bin"
        } >> "$GITHUB_PATH"
    fi

}

# Run main function
main "$@"
