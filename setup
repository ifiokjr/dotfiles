#!/usr/bin/env bash
#
# Dotfiles Setup Script
#
# This script sets up your development environment by:
# 1. Installing Determinate Nix (if not present)
# 2. Cloning the dotfiles repository (if not present)
# 3. Setting up Tuckr symlinks
# 4. Deploying configuration groups
#
# Usage:
#   Local:  ./setup [options]
#   Remote: curl -fsSL https://raw.githubusercontent.com/ifiokjr/dotfiles/refs/heads/main/setup | bash
#
# Options:
#   --cwd PATH          Clone dotfiles to PATH (default: ~/Developer/.dotfiles)
#   --preset NAME       Use a named setup preset: core, dev, workstation, ci
#   --groups GROUPS     Deploy specific groups (comma-separated; overrides preset selection)
#   --skip-nix          Skip Nix installation (use if already installed)
#   --lite              Force CLI-focused mode and skip GUI-heavy applications
#   --doctor            Run preflight checks without changing the machine
#   --validate-metadata Validate Configs/*.group.toml files and exit
#   --dry-run           Print the setup plan and exit without making changes
#   --list-groups       List available configuration groups
#   --explain-group X   Show details for one configuration group
#   --no-confirm        Run headlessly without interactive prompts
#   --help              Show this help message

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Configuration
DOTFILES_REPO="https://github.com/ifiokjr/dotfiles.git"
DEFAULT_DOTFILES_DIR="$HOME/Developer/.dotfiles"
DOTFILES_DIR=""
DEPLOY_GROUPS=""
PRESET=""
SKIP_NIX=false
LITE=false
LITE_EXPLICIT=false
VALIDATE_METADATA=false
NO_CONFIRM=false
DOCTOR=false
DRY_RUN=false
LIST_GROUPS=false
EXPLAIN_GROUP=""
DEFAULTED_PRESET=false

# Track what we install for cleanup
INSTALLED_GIT=false
INSTALLED_TUCKR=false
INSTALLED_NUSHELL=false

# Print functions
print_header() {
    echo -e "${BOLD}${CYAN}==>${NC} ${BOLD}$1${NC}"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_info() {
    echo -e "${BLUE}→${NC} $1"
}

show_help() {
    cat <<'EOF'
#
Dotfiles Setup Script
#
This script sets up your development environment by:
1. Installing Determinate Nix (if not present)
2. Cloning the dotfiles repository (if not present)
3. Setting up Tuckr symlinks
4. Deploying configuration groups
#
Usage:
  Local:  ./setup [options]
  Remote: curl -fsSL https://raw.githubusercontent.com/ifiokjr/dotfiles/refs/heads/main/setup | bash
#
Options:
  --cwd PATH          Clone dotfiles to PATH (default: ~/Developer/.dotfiles)
  --preset NAME       Use a named setup preset: core, dev, workstation, ci
  --groups GROUPS     Deploy specific groups (comma-separated; overrides preset selection)
  --skip-nix          Skip Nix installation (use if already installed)
  --lite              Force CLI-focused mode and skip GUI-heavy applications
  --doctor            Run preflight checks without changing the machine
  --validate-metadata Validate Configs/*.group.toml files and exit
  --dry-run           Print the setup plan and exit without making changes
  --list-groups       List available configuration groups
  --explain-group X   Show details for one configuration group
  --no-confirm        Run headlessly without interactive prompts
  --help              Show this help message
EOF
}

apply_bootstrap_defaults() {
    if [ -n "$PRESET" ]; then
        case "$PRESET" in
            core|dev|workstation|ci) ;;
            *)
                print_error "Unknown preset: $PRESET"
                print_info "Available presets: core, dev, workstation, ci"
                exit 1
                ;;
        esac
    fi

    if [ -z "$DEPLOY_GROUPS" ] && [ -z "$PRESET" ]; then
        PRESET="core"
        DEFAULTED_PRESET=true
    fi

    if [ -n "$PRESET" ] && [ "$LITE_EXPLICIT" = false ]; then
        case "$PRESET" in
            workstation)
                LITE=false
                ;;
            *)
                LITE=true
                ;;
        esac
    fi

    export SETUP_LITE="$LITE"
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --cwd)
                DOTFILES_DIR="$2"
                shift 2
                ;;
            --preset)
                PRESET="$2"
                shift 2
                ;;
            --groups)
                DEPLOY_GROUPS="$2"
                shift 2
                ;;
            --skip-nix)
                SKIP_NIX=true
                shift
                ;;
            --lite)
                LITE=true
                LITE_EXPLICIT=true
                shift
                ;;
            --doctor)
                DOCTOR=true
                shift
                ;;
            --validate-metadata)
                VALIDATE_METADATA=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --list-groups)
                LIST_GROUPS=true
                shift
                ;;
            --explain-group)
                EXPLAIN_GROUP="$2"
                shift 2
                ;;
            --no-confirm)
                NO_CONFIRM=true
                shift
                ;;
            --help)
                show_help
                exit 0
                ;;
            *)
                print_error "Unknown option: $1"
                echo "Run with --help for usage information"
                exit 1
                ;;
        esac
    done

    # Set default if not specified
    if [ -z "$DOTFILES_DIR" ]; then
        DOTFILES_DIR="$DEFAULT_DOTFILES_DIR"
    fi
}

# Detect platform
detect_platform() {
    case "$(uname -s)" in
        Darwin*)
            PLATFORM="macos"
            ;;
        Linux*)
            PLATFORM="linux"
            ;;
        CYGWIN*|MINGW32*|MINGW64*|MINGW*|MSYS*)
            PLATFORM="windows"
            ;;
        FreeBSD*|OpenBSD*|NetBSD*)
            PLATFORM="bsd"
            ;;
        *)
            print_error "Unknown platform: $(uname -s)"
            exit 1
            ;;
    esac
    print_info "Platform detected: $PLATFORM"
}

# Check if we're running from within the repo
check_if_in_repo() {
    if [ -f "$(dirname "$0")/setup-tuckr-symlink.sh" ] && [ -d "$(dirname "$0")/Configs" ]; then
        DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"
        print_info "Running from within dotfiles repository: $DOTFILES_DIR"
        return 0
    fi
    return 1
}

# Install Nix using Determinate Systems installer
install_nix() {
    if [ "$SKIP_NIX" = true ]; then
        print_info "Skipping Nix installation (--skip-nix flag provided)"
        return 0
    fi

    if command -v nix &> /dev/null; then
        print_success "Nix is already installed"
        return 0
    fi

    print_header "Installing Determinate Nix"

    local nix_install_args=("install")
    # Linux containers lack systemd; use root-only nix install.
    # Only applies to Linux — macOS uses launchd, not systemd.
    if [ "$(uname -s)" = "Linux" ] && [ ! -d /run/systemd/system ]; then
        nix_install_args+=("linux" "--init" "none")
    fi
    if [ "$NO_CONFIRM" = true ]; then
        nix_install_args+=("--no-confirm")
    fi

    if ! curl -fsSL https://install.determinate.systems/nix | sh -s -- "${nix_install_args[@]}"; then
        print_error "Failed to install Nix"
        exit 1
    fi

    # Source nix
    if [ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
        # shellcheck disable=SC1091
        . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
    fi

    # Configure GitHub access token if available to avoid API rate limits when
    # fetching nixpkgs. GitHub Actions provides GITHUB_TOKEN automatically.
    if [ -n "${GITHUB_TOKEN:-}" ]; then
        local nix_conf_dir="$HOME/.config/nix"
        mkdir -p "$nix_conf_dir"
        if ! grep -q "access-tokens" "$nix_conf_dir/nix.conf" 2>/dev/null; then
            echo "access-tokens = github.com=$GITHUB_TOKEN" >> "$nix_conf_dir/nix.conf"
            print_info "Configured GitHub access token for nix"
        fi
    fi

    # Root-only nix (--init none) puts binaries in /nix/var/nix/profiles/default/bin
    # which isn't in the default system PATH. Symlink them to /usr/local/bin so all
    # processes (including those spawned by sudo) can find nix, nix-env, etc.
    if [ "$(uname -s)" = "Linux" ] && [ ! -d /run/systemd/system ] && [ -d /nix/var/nix/profiles/default/bin ]; then
        print_info "Symlinking nix binaries to /usr/local/bin for system-wide access"
        for f in /nix/var/nix/profiles/default/bin/*; do
            sudo ln -sf "$f" /usr/local/bin/
        done
    fi

    print_success "Nix installed successfully"
}

# Check if a command exists
command_exists() {
    command -v "$1" &> /dev/null
}

# Check if git is present and executable (important on fresh macOS installs,
# where /usr/bin/git exists but fails until Command Line Tools are installed).
can_run_git() {
    command_exists git && git --version &> /dev/null
}

print_preclone_plan() {
    local bootstrap_tools=()
    local duration="5–20 minutes"

    if ! can_run_git; then
        bootstrap_tools+=("git")
    fi

    echo ""
    print_header "Setup plan"
    echo "  • Platform: $PLATFORM"
    if [ -n "$PRESET" ]; then
        echo "  • Preset: $PRESET"
    fi
    if [ -n "$DEPLOY_GROUPS" ]; then
        echo "  • Explicit groups: $DEPLOY_GROUPS"
    fi
    if [ -d "$DOTFILES_DIR/.git" ]; then
        echo "  • Reuse existing clone at: $DOTFILES_DIR"
    else
        echo "  • Clone repository to: $DOTFILES_DIR"
    fi
    if [ "$SKIP_NIX" = true ]; then
        echo "  • Nix: Skip installation (--skip-nix)"
    elif command_exists nix && nix --version >/dev/null 2>&1; then
        echo "  • Nix: Reuse existing installation"
    else
        echo "  • Nix: Install Determinate Nix"
    fi
    if [ ${#bootstrap_tools[@]} -gt 0 ]; then
        echo "  • Temporary bootstrap tools: ${bootstrap_tools[*]}"
    else
        echo "  • Temporary bootstrap tools: none"
    fi
    if [ "$LITE" = true ]; then
        echo "  • GUI applications: CLI-focused / GUI-heavy applications skipped"
    else
        echo "  • GUI applications: GUI-heavy applications may be installed"
        duration="10–30 minutes"
    fi
    if [ "$PRESET" = "workstation" ]; then
        duration="20–40 minutes"
    elif [ "$PRESET" = "ci" ]; then
        duration="5–10 minutes"
    fi
    echo "  • Expected duration: $duration"
    echo "  • Detailed group and hook plan will be shown after the repository-local setup entry point is available"
    echo ""
}

# Resolve a working git binary, preferring PATH and then common Nix locations.
find_working_git() {
    local candidate
    local profile_user

    if can_run_git; then
        command -v git
        return 0
    fi

    profile_user="${USER:-$(whoami)}"
    for candidate in \
        "$HOME/.nix-profile/bin/git" \
        "/etc/profiles/per-user/$profile_user/bin/git" \
        "/nix/var/nix/profiles/default/bin/git"
    do
        if [ -x "$candidate" ] && "$candidate" --version &> /dev/null; then
            echo "$candidate"
            return 0
        fi
    done

    return 1
}

# Wait for macOS Command Line Tools to become available.
wait_for_macos_developer_tools() {
    local max_wait_seconds="${1:-1800}"
    local interval_seconds=10
    local waited_seconds=0

    while ! xcode-select -p &> /dev/null; do
        if [ "$waited_seconds" -eq 0 ]; then
            print_info "Waiting for Command Line Tools installation to finish..."
        elif [ $((waited_seconds % 60)) -eq 0 ]; then
            print_info "Still waiting for Command Line Tools... (${waited_seconds}s elapsed)"
        fi

        sleep "$interval_seconds"
        waited_seconds=$((waited_seconds + interval_seconds))

        if [ "$waited_seconds" -ge "$max_wait_seconds" ]; then
            print_warning "Timed out waiting for Command Line Tools after ${max_wait_seconds}s"
            return 1
        fi
    done

    return 0
}

# Ensure Xcode Command Line Tools are installed on macOS.
ensure_macos_developer_tools() {
    local install_output

    if [ "$PLATFORM" != "macos" ]; then
        return 0
    fi

    if xcode-select -p &> /dev/null; then
        print_success "macOS developer tools are already installed"
        return 0
    fi

    print_header "Installing macOS developer tools"
    print_info "Command Line Tools are required for Apple's developer toolchain"

    if install_output="$(xcode-select --install 2>&1)"; then
        print_info "Started Command Line Tools installer"
    else
        if echo "$install_output" | grep -qiE "already installed|already being installed|software update"; then
            print_info "Command Line Tools installation is already in progress"
        else
            print_warning "Could not start Command Line Tools installer automatically"
            print_warning "$install_output"
            return 1
        fi
    fi

    print_info "If prompted, accept the installer dialog to continue setup"
    if wait_for_macos_developer_tools 1800; then
        print_success "macOS developer tools installed"
        return 0
    fi

    return 1
}

# Run nix commands, using sudo when nix was installed root-only (--init none).
# Nix binaries are symlinked to /usr/local/bin so PATH isn't needed.
# HOME is preserved so profile installs go to the calling user's profile.
run_nix() {
    if [ "$(uname -s)" = "Linux" ] && [ ! -d /run/systemd/system ] && [ "$(id -u)" -ne 0 ]; then
        sudo HOME="$HOME" nix "$@"
    else
        nix "$@"
    fi
}

# Install git via nix profile if needed
install_git() {
    if can_run_git; then
        print_success "Git is already available"
        return 0
    fi

    # Fresh macOS installs provide /usr/bin/git but require Command Line Tools
    # before git is actually executable.
    if [ "$PLATFORM" = "macos" ]; then
        if ensure_macos_developer_tools && can_run_git; then
            print_success "Git is already available"
            return 0
        fi
        print_warning "Using Nix-provided git while macOS Command Line Tools are unavailable"
    fi

    print_header "Installing git temporarily"

    if ! run_nix profile add nixpkgs#git; then
        print_error "Failed to install git"
        exit 1
    fi

    INSTALLED_GIT=true

    if ! find_working_git > /dev/null; then
        print_error "Git was installed but no executable git binary was found"
        exit 1
    fi

    print_success "Git installed"
}

# Install tuckr via nix profile if needed
install_tuckr() {
    if command_exists tuckr; then
        print_success "Tuckr is already available"
        return 0
    fi

    print_header "Installing tuckr temporarily"

    if ! run_nix profile add nixpkgs#tuckr; then
        print_error "Failed to install tuckr"
        exit 1
    fi

    INSTALLED_TUCKR=true
    print_success "Tuckr installed"
}

# Install nushell via nix profile if needed (scripts require it)
install_nushell() {
    if command_exists nu; then
        print_success "Nushell is already available"
        return 0
    fi

    print_header "Installing nushell temporarily"

    if ! run_nix profile add nixpkgs#nushell; then
        print_error "Failed to install nushell"
        exit 1
    fi

    INSTALLED_NUSHELL=true
    print_success "Nushell installed"
}

# Clone the dotfiles repository
clone_dotfiles() {
    local git_bin

    if [ -d "$DOTFILES_DIR/.git" ]; then
        print_success "Dotfiles repository already exists at $DOTFILES_DIR"
        return 0
    fi

    print_header "Cloning dotfiles repository"
    print_info "Destination: $DOTFILES_DIR"

    # Create parent directory if it doesn't exist
    mkdir -p "$(dirname "$DOTFILES_DIR")"

    if ! git_bin="$(find_working_git)"; then
        print_error "No executable git binary found (install may be incomplete)"
        exit 1
    fi

    if ! "$git_bin" clone "$DOTFILES_REPO" "$DOTFILES_DIR"; then
        print_error "Failed to clone dotfiles repository"
        exit 1
    fi

    print_success "Dotfiles cloned successfully"
}

# Setup Tuckr symlink
setup_tuckr_symlink() {
    print_header "Setting up Tuckr symlink"

    if ! "$DOTFILES_DIR/setup-tuckr-symlink.sh" "$DOTFILES_DIR"; then
        print_error "Failed to setup Tuckr symlink"
        exit 1
    fi

    print_success "Tuckr symlink configured"
}

source_setup_libraries() {
    local setup_lib_dir="$DOTFILES_DIR/lib/setup"

    # shellcheck disable=SC1091
    . "$setup_lib_dir/common.sh"
    # shellcheck disable=SC1091
    . "$setup_lib_dir/groups.sh"
    # shellcheck disable=SC1091
    . "$setup_lib_dir/deploy.sh"
    # shellcheck disable=SC1091
    . "$setup_lib_dir/doctor.sh"
    # shellcheck disable=SC1091
    . "$setup_lib_dir/plan.sh"
    # shellcheck disable=SC1091
    . "$setup_lib_dir/verify.sh"
}

apply_setup_defaults() {
    if [ -n "$PRESET" ] && ! preset_exists "$PRESET"; then
        print_error "Unknown preset: $PRESET"
        print_info "Available presets: core, dev, workstation, ci"
        exit 1
    fi

    if [ -n "$DEPLOY_GROUPS" ] && [ -n "$PRESET" ]; then
        print_info "Explicit groups override preset group selection; preset still controls default lite mode"
    fi

    if [ -z "$DEPLOY_GROUPS" ] && [ -z "$PRESET" ]; then
        PRESET="core"
        DEFAULTED_PRESET=true
    fi

    if [ -n "$PRESET" ] && [ "$LITE_EXPLICIT" = false ]; then
        LITE="$(preset_default_lite "$PRESET")"
    fi

    export SETUP_LITE="$LITE"
}

run_bootstrap_doctor() {
    local problems=0
    local warnings=0
    local available_kb
    local target_dir
    local tuckr_path

    print_header "Dotfiles Doctor"
    print_success "Platform supported: $PLATFORM"

    if command_exists curl; then
        print_success "curl available"
    else
        print_error "curl is required for bootstrap and is not installed"
        problems=$((problems + 1))
    fi

    if can_run_git; then
        print_success "Git available"
    elif [ "$PLATFORM" = "macos" ]; then
        print_warning "Git is not runnable yet; setup can fall back to Nix, but Command Line Tools may still be missing"
        warnings=$((warnings + 1))
    else
        print_warning "Git is not installed; setup can install it temporarily after Nix"
        warnings=$((warnings + 1))
    fi

    if command_exists sudo; then
        if sudo -n true 2>/dev/null; then
            print_success "sudo available without prompting"
        else
            print_info "sudo available (setup may prompt when applying system changes)"
        fi
    else
        print_warning "sudo not found; some setup paths may not work"
        warnings=$((warnings + 1))
    fi

    if command_exists nix && nix --version >/dev/null 2>&1; then
        print_success "Nix installed and responding"
    else
        print_info "Nix not installed (setup can install it unless --skip-nix is used)"
    fi

    if [ "$PLATFORM" = "macos" ]; then
        if xcode-select -p >/dev/null 2>&1; then
            print_success "Xcode Command Line Tools installed"
        else
            print_warning "Xcode Command Line Tools are not installed yet"
            warnings=$((warnings + 1))
        fi
    fi

    available_kb="$(df -Pk "$HOME" | awk 'NR==2 { print $4 }')"
    if [ -n "$available_kb" ] && [ "$available_kb" -lt 10485760 ]; then
        print_warning "Less than 10 GiB free in the home filesystem; large Nix builds may fail"
        warnings=$((warnings + 1))
    else
        print_success "Sufficient free disk space detected"
    fi

    if [ -n "${GITHUB_TOKEN:-}" ]; then
        print_success "GITHUB_TOKEN is set"
    else
        print_warning "GITHUB_TOKEN is not set; GitHub-backed fetches may be rate limited"
        warnings=$((warnings + 1))
    fi

    target_dir="$DOTFILES_DIR"
    if mkdir -p "$(dirname "$target_dir")" 2>/dev/null; then
        print_success "Dotfiles parent directory is writable: $(dirname "$target_dir")"
    else
        print_error "Cannot write to the dotfiles parent directory: $(dirname "$target_dir")"
        problems=$((problems + 1))
    fi

    case "$PLATFORM" in
        macos)
            tuckr_path="$HOME/Library/Application Support/dotfiles"
            ;;
        linux | bsd | windows)
            tuckr_path="$HOME/.config/dotfiles"
            ;;
    esac

    if mkdir -p "$(dirname "$tuckr_path")" 2>/dev/null; then
        print_success "Tuckr symlink parent directory is writable: $(dirname "$tuckr_path")"
    else
        print_error "Cannot write to the Tuckr symlink parent directory: $(dirname "$tuckr_path")"
        problems=$((problems + 1))
    fi

    if command_exists curl && curl --head --silent --fail --location https://github.com >/dev/null 2>&1; then
        print_success "GitHub reachable"
    else
        print_warning "GitHub could not be reached during the preflight check"
        warnings=$((warnings + 1))
    fi

    echo ""
    if [ "$problems" -gt 0 ]; then
        print_error "Doctor found $problems blocking issue(s) and $warnings warning(s)"
        return 1
    fi

    if [ "$warnings" -gt 0 ]; then
        print_warning "Doctor found $warnings warning(s), but no blocking issues"
    else
        print_success "Doctor found no obvious blockers"
    fi
}

# Ask user for confirmation
ask_yes_no() {
    local prompt="$1"
    local response

    while true; do
        read -rp "$(echo -e "${CYAN}?${NC} $prompt [y/N]: ")" response
        case "$response" in
            [Yy]|[Yy][Ee][Ss])
                return 0
                ;;
            [Nn]|[Nn][Oo]|"")
                return 1
                ;;
            *)
                print_warning "Please answer yes or no"
                ;;
        esac
    done
}

# Cleanup temporary packages
cleanup() {
    print_header "Cleaning up"

    if [ "$INSTALLED_TUCKR" = true ]; then
        print_info "Removing tuckr from nix profile"
        run_nix profile remove --regex '.*tuckr.*' || print_warning "Could not remove tuckr (may already be removed)"
    fi

    if [ "$INSTALLED_NUSHELL" = true ]; then
        print_info "Removing nushell from nix profile"
        run_nix profile remove --regex '.*nushell.*' || print_warning "Could not remove nushell (may already be removed)"
    fi

    if [ "$INSTALLED_GIT" = true ]; then
        print_info "Removing git from nix profile"
        run_nix profile remove --regex '.*git.*' || print_warning "Could not remove git (may already be removed)"
    fi

    print_success "Cleanup complete"
}

# Main setup flow
main() {
    echo ""
    echo -e "${BOLD}${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}${CYAN}║                                        ║${NC}"
    echo -e "${BOLD}${CYAN}║      Dotfiles Setup Script             ║${NC}"
    echo -e "${BOLD}${CYAN}║                                        ║${NC}"
    echo -e "${BOLD}${CYAN}╚════════════════════════════════════════╝${NC}"
    echo ""

    local started_in_repo=false
    local deploy_exit=0
    local original_args=("$@")

    # shellcheck disable=SC2034
    STARTED_IN_REPO=false

    parse_args "$@"
    export NO_CONFIRM
    detect_platform
    apply_bootstrap_defaults

    if check_if_in_repo; then
        started_in_repo=true
        # shellcheck disable=SC2034
        STARTED_IN_REPO=true
        source_setup_libraries
        apply_setup_defaults
    fi

    if [ "$VALIDATE_METADATA" = true ] || [ "$LIST_GROUPS" = true ] || [ -n "$EXPLAIN_GROUP" ]; then
        if [ "$started_in_repo" = false ]; then
            if [ -d "$DOTFILES_DIR/Configs" ] && [ -d "$DOTFILES_DIR/lib/setup" ] && [ -f "$DOTFILES_DIR/setup" ]; then
                DOTFILES_DIR="$(cd "$DOTFILES_DIR" && pwd)"
                # shellcheck disable=SC2034
                STARTED_IN_REPO=true
                source_setup_libraries
            else
                print_error "This command requires a local dotfiles checkout"
                exit 1
            fi
        fi

        if [ "$LIST_GROUPS" = true ]; then
            list_groups
            exit $?
        fi

        if [ -n "$EXPLAIN_GROUP" ]; then
            explain_group "$EXPLAIN_GROUP"
            exit $?
        fi

        print_header "Validating group metadata"
        validate_all_group_metadata
        exit $?
    fi

    if [ "$DOCTOR" = true ]; then
        if [ "$started_in_repo" = false ]; then
            print_info "Doctor is running before cloning the repository"
            run_bootstrap_doctor
        else
            run_doctor
        fi
        exit $?
    fi

    if [ "$started_in_repo" = false ]; then
        print_preclone_plan
        if [ "$DRY_RUN" = true ]; then
            exit 0
        fi

        install_nix
        install_git
        clone_dotfiles
        print_info "Switching to the repository-local setup entry point"
        exec "$DOTFILES_DIR/setup" "${original_args[@]}"
    fi

    if ! command_exists nix && [ "$SKIP_NIX" = false ]; then
        install_nix
    fi

    source_setup_libraries
    apply_setup_defaults

    if [ "$DEFAULTED_PRESET" = true ]; then
        print_info "No preset specified; defaulting to the safer '$PRESET' preset"
        print_info "Preset description: $(preset_description "$PRESET")"
    elif [ -n "$PRESET" ]; then
        print_info "Using preset '$PRESET': $(preset_description "$PRESET")"
    fi

    if [ "$LITE" = true ]; then
        print_info "Lite mode enabled: GUI-heavy applications will be skipped"
    else
        print_info "Full mode enabled: GUI-heavy applications may be installed"
    fi

    if command_exists nu; then
        resolve_requested_groups
        print_execution_plan
    else
        print_bootstrap_plan
    fi

    if [ "$DRY_RUN" = true ]; then
        exit 0
    fi

    install_tuckr
    install_nushell

    setup_tuckr_symlink
    deploy_groups || deploy_exit=$?

    # Cleanup
    cleanup

    # Exit with failure if any group deployment failed.
    # Avoid printing a success banner in this case.
    if [ "$deploy_exit" -ne 0 ]; then
        echo ""
        print_error "Setup completed with errors"
        exit "$deploy_exit"
    fi

    echo ""
    echo -e "${GREEN}${BOLD}╔════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}${BOLD}║                                        ║${NC}"
    echo -e "${GREEN}${BOLD}║      Setup Complete! 🎉                ║${NC}"
    echo -e "${GREEN}${BOLD}║                                        ║${NC}"
    echo -e "${GREEN}${BOLD}╚════════════════════════════════════════╝${NC}"
    echo ""
    print_info "Your dotfiles have been installed to: $DOTFILES_DIR"
    print_info "Configuration files are now symlinked to your home directory"
    echo ""
    run_setup_verification
    print_header "Next Steps"

    if [ "$PLATFORM" = "macos" ]; then
        echo -e "  ${CYAN}1.${NC} Open a new terminal window"
        echo -e "  ${CYAN}2.${NC} Verify Tuckr status: ${BOLD}tuckr status${NC}"
        echo -e "  ${CYAN}3.${NC} Check configuration: ${BOLD}ls -la ~ | grep '^l'${NC} (shows symlinks)"
    else
        echo -e "  ${CYAN}1.${NC} Restart your terminal"
        echo -e "  ${CYAN}2.${NC} Verify Tuckr status: ${BOLD}tuckr status${NC}"
        echo -e "  ${CYAN}3.${NC} Check configuration: ${BOLD}ls -la ~ | grep '^l'${NC} (shows symlinks)"
    fi

    echo ""
    print_info "For more information, see: $DOTFILES_DIR/README.md"
    echo ""

    # In GitHub Actions, export current PATH entries to GITHUB_PATH so that
    # binaries installed by setup (via home-manager, nix profile, etc.) are
    # available in subsequent workflow steps.
    # Use ${VAR:-} to avoid "unbound variable" errors from set -u.
    if [ -n "${GITHUB_ACTIONS:-}" ] && [ -n "${GITHUB_PATH:-}" ]; then
        print_info "Exporting PATH to GITHUB_PATH for subsequent steps"
        print_info "GITHUB_PATH file: $GITHUB_PATH"
        print_info "Current PATH entries:"
        echo "$PATH" | tr ':' '\n' | while read -r p; do
            echo "  $p"
        done
        {
            echo "$PATH" | tr ':' '\n'
            # Ensure nix profile paths are available even if not yet in PATH
            echo "/etc/profiles/per-user/${USER:-$(whoami)}/bin"
            echo "/run/current-system/sw/bin"
        } >> "$GITHUB_PATH"
    fi

}

# Run main function
main "$@"
