# Nix build outputs and autogenerated files
.config/nix/result
.config/nix/result-*
.config/nix/.devenv/
.config/nix/.direnv/

# Generated during rebuild (gitignored, not managed by tuckr)
.config/nix/machine.nix
.config/nix/flake.lock

# Backup files
.config/nix/packages/*.backup
.config/nix/packages/*.backup.*

# Nix evaluation cache
.config/nix/.nix-defexpr/
.config/nix/.nix-channels
