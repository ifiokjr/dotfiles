#!/usr/bin/env nu
# Install custom Helix editor with Steel plugin system
#
# This script:
# - Clones/updates the Helix fork with Steel event system support
# - Builds Helix with the Steel plugin ecosystem
# - Installs the steel language, language server, and package manager
# - Creates a symlink at ~/.local/bin/hx for easy access
# - Creates a symlink at ~/.config/helix/runtime to the custom runtime

use nu_modules/print_utils.nu *

def check_requirements [] {
    info "Checking requirements..."

    let missing = (
        ["git" "cargo"]
        | where { |tool| (which $tool | is-empty) }
    )

    if ($missing | is-not-empty) {
        err $"Missing required tools: ($missing | str join ', ')"
        info "Please install the missing tools and try again."
        exit 1
    }

    success "All requirements met"
}

def setup_repository [helix_dir: string, repo_url: string, branch: string] {
    if ($helix_dir | path exists) {
        info $"Repository exists at ($helix_dir)"
        info $"Updating to latest ($branch)..."

        cd $helix_dir

        # Fetch latest changes
        ^git fetch origin

        # Check if we're on the correct branch
        let current_branch = (^git rev-parse --abbrev-ref HEAD | str trim)
        if $current_branch != $branch {
            warn $"Currently on branch '($current_branch)', switching to '($branch)'..."
            ^git checkout $branch
        }

        # Pull latest changes
        let pull_result = do -i { ^git pull origin $branch }
        if ($env.LAST_EXIT_CODE == 0) {
            success "Repository updated successfully"
        } else {
            err "Failed to update repository"
            exit 1
        }
    } else {
        info $"Cloning repository to ($helix_dir)..."

        let clone_result = do -i { ^git clone --branch $branch $repo_url $helix_dir }
        if ($env.LAST_EXIT_CODE == 0) {
            success "Repository cloned successfully"
            cd $helix_dir
        } else {
            err "Failed to clone repository"
            exit 1
        }
    }
}

# Create symlinks so the custom-built hx binary is on PATH (~/.local/bin/hx)
# and helix finds its runtime directory (~/.config/helix/runtime -> source checkout)
def setup_symlinks [helix_dir: string, helix_bin: string, runtime_src: string, runtime_dest: string] {
    let bin_dir = ($helix_bin | path dirname)
    let config_dir = ($runtime_dest | path dirname)
    let target_bin = $"($helix_dir)/target/release/hx"

    # Ensure directories exist
    if not ($bin_dir | path exists) {
        info $"Creating directory: ($bin_dir)"
        mkdir $bin_dir
    }
    if not ($config_dir | path exists) {
        info $"Creating directory: ($config_dir)"
        mkdir $config_dir
    }

    # Setup binary symlink
    if ($helix_bin | path type) == "symlink" {
        info $"Removing existing symlink at ($helix_bin)"
        rm -f $helix_bin
    } else if ($helix_bin | path exists) {
        warn $"File exists at ($helix_bin) \(not a symlink\)"
        warn "Please remove it manually if you want to create the symlink"
        return
    }

    info $"Creating symlink: ($helix_bin) -> ($target_bin)"
    ^ln -sf $target_bin $helix_bin
    success "Binary symlink created successfully"

    # Setup runtime symlink (overwrite if exists)
    if ($runtime_dest | path exists) or (($runtime_dest | path type) == "symlink") {
        info $"Removing existing runtime at ($runtime_dest)"
        rm -rf $runtime_dest
    }

    info $"Creating symlink: ($runtime_dest) -> ($runtime_src)"
    ^ln -sf $runtime_src $runtime_dest
    success "Runtime symlink created successfully"

    # Symlink steel tools from ~/.cargo/bin/ to ~/.local/bin/
    # cargo xtask steel installs these into ~/.cargo/bin/ but they need to be
    # on PATH via ~/.local/bin/ for global access
    let steel_tools = ["steel" "forge" "steel-language-server"]
    for tool in $steel_tools {
        let cargo_bin = $"($env.HOME)/.cargo/bin/($tool)"
        let local_bin = $"($bin_dir)/($tool)"
        if ($cargo_bin | path exists) {
            if ($local_bin | path exists) or (($local_bin | path type) == "symlink") {
                rm -f $local_bin
            }
            ^ln -sf $cargo_bin $local_bin
            success $"Symlinked ($tool) -> ($local_bin)"
        } else {
            warn $"($tool) not found at ($cargo_bin), skipping symlink"
        }
    }

    info "You can now run: hx"
}

# Install forge packages required by init.scm (splash screen, keymaps, etc.)
def install_forge_packages [] {
    let forge_bin = $"($env.HOME)/.local/bin/forge"
    if not ($forge_bin | path exists) {
        warn "forge not found, skipping package installation"
        return
    }

    info "Installing forge packages..."
    let result = do -i { ^$forge_bin pkg install --git https://github.com/mattwparas/helix-config.git }
    if ($env.LAST_EXIT_CODE == 0) {
        success "Forge packages installed successfully"
    } else {
        warn "Failed to install forge packages (you can run 'forge pkg install --git https://github.com/mattwparas/helix-config.git' manually)"
    }
}

def build_helix [helix_dir: string, helix_bin: string, runtime_src: string, runtime_dest: string] {
    # Steel is an embeddable Scheme (Lisp) dialect that the Helix fork uses for
    # scripting/plugin support. `cargo xtask steel` builds the full ecosystem:
    # the hx binary, Steel language runtime, LSP server, and package manager.
    info "Building Helix with Steel plugin system..."
    info "This will install:"
    print "  • hx executable with Steel support"
    print "  • steel language"
    print "  • steel language server"
    print "  • dylib installer for dependencies"
    print "  • forge package manager"
    print ""

    cd $helix_dir

    let build_result = do -i { ^cargo xtask steel }
    if ($env.LAST_EXIT_CODE == 0) {
        success "Helix built successfully with Steel ecosystem"
        print ""

        # Create symlinks for binary and runtime
        setup_symlinks $helix_dir $helix_bin $runtime_src $runtime_dest

        # Install forge packages required by init.scm
        install_forge_packages

        print ""
        info "Installation complete!"
        info $"Binary: ($helix_dir)/target/release/hx"
        info $"Binary symlink: ($helix_bin)"
        info $"Runtime: ($runtime_src)"
        info $"Runtime symlink: ($runtime_dest)"
        print ""
        info "Next steps:"
        print "  1. Configuration files will be auto-generated at:"
        print "     ~/.config/helix/helix.scm"
        print "     ~/.config/helix/init.scm"
        print ""
        print "  2. (Optional) Create a cogs directory for community libraries:"
        print "     mkdir -p ~/.config/helix/cogs"
        print ""
        print "  3. Ensure ~/.local/bin is in your PATH (already configured in env.nu)"
    } else {
        err "Failed to build Helix"
        exit 1
    }
}

def main [] {
    let helix_dir = $"($env.HOME)/.custom-helix"
    let helix_bin = $"($env.HOME)/.local/bin/hx"
    let runtime_src = $"($env.HOME)/.custom-helix/runtime"
    let runtime_dest = $"($env.HOME)/.config/helix/runtime"
    let repo_url = "https://github.com/mattwparas/helix"
    let branch = "steel-event-system"

    info "Installing custom Helix editor with Steel plugin system"
    print ""

    check_requirements
    setup_repository $helix_dir $repo_url $branch
    build_helix $helix_dir $helix_bin $runtime_src $runtime_dest

    print ""
    success "Installation complete!"
}
