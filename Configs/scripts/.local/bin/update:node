#!/usr/bin/env nu
# Update Node.js to the latest version using pnpm env
#
# This script uses pnpm's built-in Node.js management to install
# and activate the latest stable version of Node.js globally.

use nu_modules/print_utils.nu *

def main [] {
    # Check if pnpm is available
    if (which pnpm | is-empty) {
        err "pnpm is not installed or not in PATH"
        print ""
        info "Make sure pnpm is installed and open a new terminal to update PATH"
        exit 1
    }

    info "Current Node.js version:"
    if (which node | is-not-empty) {
        let current = (^node --version | str trim)
        print $"  ($current)"
    } else {
        print "  No Node.js installation found"
    }

    print ""
    info "Installing latest Node.js version via pnpm..."
    print ""

    let result = do -i { ^pnpm env use --global latest }
    if ($env.LAST_EXIT_CODE == 0) {
        print ""
        success "Node.js updated successfully!"
        print ""
        info "New Node.js version:"
        let new_version = (^node --version | str trim)
        print $"  ($new_version)"
        print ""
        info "npm version:"
        let npm_version = (^npm --version | str trim)
        print $"  v($npm_version)"
        print ""
        success "Done! Node.js is ready to use."
    } else {
        err "Failed to update Node.js"
        print ""
        info "Try running manually: pnpm env use --global latest"
        exit 1
    }
}
