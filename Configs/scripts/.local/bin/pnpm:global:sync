#!/usr/bin/env bash
set -euo pipefail

# Install managed pnpm CLI tools from Tuckr-managed manifests at
# ~/.config/pnpm-global into a runtime project outside the Tuckr group. This
# keeps generated node_modules out of dotfiles while still letting git pull
# update the managed package.json and lockfile.

QUIET=false
NO_FAIL=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --quiet)
      QUIET=true
      ;;
    --no-fail)
      NO_FAIL=true
      ;;
    -h|--help)
      cat <<'USAGE'
Usage: pnpm:global:sync [--quiet] [--no-fail]

Install managed CLI packages from ~/.config/pnpm-global into the runtime
project at ~/.local/share/pnpm-global.

Options:
  --quiet    Suppress info output
  --no-fail  Return success even when sync/install fails
USAGE
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
  shift
done

info() {
  if [ "$QUIET" = false ]; then
    echo "$*"
  fi
}

warn() {
  echo "$*" >&2
}

fail() {
  warn "$*"
  if [ "$NO_FAIL" = true ]; then
    return 0
  fi
  return 1
}

user_name="${USER:-}"
if [ -z "$user_name" ]; then
  user_name="$(id -un 2>/dev/null || true)"
fi

profile_paths=(
  "$HOME/.nix-profile/bin"
  "/run/current-system/sw/bin"
  "/nix/var/nix/profiles/default/bin"
)

if [ -n "$user_name" ]; then
  profile_paths+=("/etc/profiles/per-user/${user_name}/bin")
fi

for _p in "${profile_paths[@]}"; do
  [ -d "$_p" ] && case ":$PATH:" in *":$_p:"*) ;; *) export PATH="$_p:$PATH" ;; esac
done
unset _p user_name profile_paths

if ! command -v pnpm >/dev/null 2>&1; then
  fail "pnpm is not installed; skipping managed pnpm global sync"
  exit $?
fi

SOURCE_DIR="$HOME/.config/pnpm-global"
RUNTIME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm-global"

if [ ! -f "$SOURCE_DIR/package.json" ]; then
  info "No $SOURCE_DIR/package.json found; skipping managed pnpm global sync"
  exit 0
fi

# Clean up stale node_modules from the old layout where pnpm installed directly
# into the Tuckr-managed config directory.
if [ -d "$SOURCE_DIR/node_modules" ]; then
  info "Removing stale $SOURCE_DIR/node_modules (generated artifacts belong in $RUNTIME_DIR)"
  rm -rf "$SOURCE_DIR/node_modules"
fi

# Ensure runtime bin directory is on PATH so newly installed CLIs are
# immediately available (e.g. during rebuild or activation hooks).
RUNTIME_BIN="$RUNTIME_DIR/node_modules/.bin"
if [ -d "$RUNTIME_BIN" ]; then
  case ":$PATH:" in
    *":$RUNTIME_BIN:"*) ;;
    *) export PATH="$RUNTIME_BIN:$PATH" ;;
  esac
fi

mkdir -p "$RUNTIME_DIR"

for manifest in package.json pnpm-lock.yaml pnpm-workspace.yaml; do
  src="$SOURCE_DIR/$manifest"
  dest="$RUNTIME_DIR/$manifest"

  if [ -f "$src" ]; then
    rm -f "$dest"
    ln -s "$src" "$dest"
  elif [ -L "$dest" ]; then
    rm -f "$dest"
  fi
done

cd "$RUNTIME_DIR"

if [ -f pnpm-lock.yaml ]; then
  if pnpm install --frozen-lockfile --ignore-scripts; then
    info "Managed pnpm global packages synced"
    exit 0
  fi

  warn "pnpm install with frozen lockfile failed; retrying without --frozen-lockfile..."
fi

if ! pnpm install --ignore-scripts; then
  fail "Managed pnpm global package install failed"
  exit $?
fi

info "Managed pnpm global packages synced"
