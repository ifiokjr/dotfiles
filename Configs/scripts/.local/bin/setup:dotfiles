#!/usr/bin/env bash
#
# setup:dotfiles — Convenience wrapper for the setup script.
#
# Passes all arguments through to ./setup.
#
# Usage:
#   ./setup:dotfiles [options]
#
# See ./setup --help for available options.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Resolve the dotfiles repository root (walk up from Configs/scripts/.local/bin/).
# This may fail if called after the dotfiles directory was deleted (e.g. during
# reset:dotfiles).  In that case, fall back to the default location.
DOTFILES_ROOT="$(cd "$SCRIPT_DIR/../../../.." 2>/dev/null && pwd)" || {
    DOTFILES_ROOT="$HOME/Developer/.dotfiles"
}

# If the CWD was deleted (common during reset), switch to a safe directory.
if [ ! -d "$(pwd -P 2>/dev/null || true)" ]; then
    cd "$HOME" || cd /
fi

exec "$DOTFILES_ROOT/setup" "$@"