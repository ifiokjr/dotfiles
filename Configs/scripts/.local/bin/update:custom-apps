#!/usr/bin/env nu
# Update custom app packages (rolling-URL hashes + versioned app versions)
#
# This script handles two categories of custom macOS app packages:
#
# 1. Rolling-URL packages (google-chrome, steam, google-drive):
#    Always re-prefetch the hash since the URL points to the latest release.
#
# 2. Versioned packages (zoom, nordvpn, gpg-suite):
#    Check Homebrew API for new versions. If updated, prefetch new hashes.
#
# Called automatically during `rebuild` unless --skip-updates is passed.

use nu_modules/print_utils.nu *

# Prefetch a URL and return the SRI hash
def prefetch-hash [url: string]: nothing -> string {
    let hash = (^nix-prefetch-url $url out+err>| lines | last | str trim)
    ^nix hash convert --hash-algo sha256 --to sri $hash | str trim
}

# Build a regex pattern that matches a keyed hash entry.
# Uses str join to avoid nushell's $'...' interpolation eating regex capture groups.
# Returns a regex like: "key" = \{[^}]*hash = "([^"]*)"
def hash-re [key: string]: nothing -> string {
    [$"\"($key)\" = \\{[^}]*hash = " '"([^"]*)"'] | str join
}

# Parse the current hash for a keyed entry from nix file content.
# Returns empty string if not found.
def parse-hash [content: string, key: string]: nothing -> string {
    let re = (hash-re $key)
    try { $content | parse --regex $re | get capture0.0 } catch { "" }
}

# Update a rolling-URL package (re-prefetch hash, update if changed)
def update-rolling [name: string, nix_file: string, urls: list<record<label: string, url: string, pattern: string>>] {
    info $"Checking ($name)..."

    if not ($nix_file | path exists) {
        warn $"($nix_file) not found, skipping"
        return
    }

    mut content = (open $nix_file --raw)
    mut changed = false

    for entry in $urls {
        let new_hash = try {
            prefetch-hash $entry.url
        } catch {
            warn $"  Failed to prefetch ($entry.label), skipping"
            continue
        }

        # Build parse regex: pattern = "([^"]*)"
        # Use str join to avoid $'...' eating the capture group
        let parse_re = [$entry.pattern ' = "' '([^"]*)"'] | str join
        let current_hash = try {
            $content | parse --regex $parse_re | get capture0.0
        } catch {
            ""
        }

        if $current_hash == $new_hash {
            success $"  ($entry.label): up to date"
        } else {
            # Replace using the pattern (no backreferences needed)
            let search_re = [$entry.pattern ' = "[^"]*"'] | str join
            let replacement = $"($entry.pattern) = \"($new_hash)\""
            $content = ($content | str replace --regex $search_re $replacement)
            $changed = true
            success $"  ($entry.label): updated"
        }
    }

    if $changed {
        $content | save -f $nix_file
        success $"  ($name) hashes updated"
    }
}

# Update a versioned package (check Homebrew API for new version + prefetch)
def update-versioned [
    name: string,
    cask_name: string,
    nix_file: string,
    url_builder: closure,  # closure that takes version and returns list of {label, url, pattern}
] {
    info $"Checking ($name)..."

    if not ($nix_file | path exists) {
        warn $"($nix_file) not found, skipping"
        return
    }

    # Fetch latest version from Homebrew API
    let latest_version = try {
        http get $"https://formulae.brew.sh/api/cask/($cask_name).json" | get version
    } catch {
        warn $"  Failed to fetch version from Homebrew API, skipping"
        return
    }

    let content = (open $nix_file --raw)
    let current_version = try {
        $content | parse --regex 'version = "([^"]+)"' | get capture0.0
    } catch {
        warn $"  Could not read current version, skipping"
        return
    }

    if $current_version == $latest_version {
        success $"  ($name): v($current_version) \(latest\)"
        return
    }

    info $"  Updating ($current_version) → ($latest_version)"

    # Update version
    mut updated = ($content | str replace --regex 'version = "[^"]+"' $"version = \"($latest_version)\"")

    # Prefetch new hashes
    let entries = (do $url_builder $latest_version)

    for entry in $entries {
        let new_hash = try {
            prefetch-hash $entry.url
        } catch {
            warn $"  Failed to prefetch ($entry.label), skipping ($name)"
            return
        }
        let search_re = [$entry.pattern ' = "[^"]*"'] | str join
        let replacement = $"($entry.pattern) = \"($new_hash)\""
        $updated = ($updated | str replace --regex $search_re $replacement)
        success $"  ($entry.label): prefetched"
    }

    $updated | save -f $nix_file
    success $"  ($name) updated to ($latest_version)"
}

def main [
    --skip-rebuild  # Skip the rebuild step after updating
] {
    let packages_dir = $"($env.HOME)/.config/nix/packages"

    info "Updating custom app packages..."
    print ""

    # ── Rolling-URL packages ──────────────────────────────────────────
    # These always point to the latest release; re-prefetch every time.

    # Google Chrome: update all architecture hashes explicitly.
    # The macOS universal DMG is shared by x86_64-darwin and aarch64-darwin,
    # so both entries must be updated together. The Linux URL is separate.
    let chrome_file = $"($packages_dir)/google-chrome.nix"
    if ($chrome_file | path exists) {
        info "Checking google-chrome..."
        mut content = (open $chrome_file --raw)
        mut changed = false

        # macOS universal (same URL for both x86_64-darwin and aarch64-darwin)
        let mac_hash = try {
            prefetch-hash "https://dl.google.com/chrome/mac/universal/stable/GGRO/googlechrome.dmg"
        } catch {
            warn "  Failed to prefetch macOS hash"
            null
        }

        if $mac_hash != null {
            for arch in ["x86_64-darwin" "aarch64-darwin"] {
                let current = (parse-hash $content $arch)

                if $current == $mac_hash {
                    success $"  ($arch): up to date"
                } else if ($current | is-not-empty) {
                    # Direct replacement: swap old hash value for new (no regex backreferences)
                    $content = ($content | str replace $"hash = \"($current)\"" $"hash = \"($mac_hash)\"")
                    $changed = true
                    success $"  ($arch): updated"
                } else {
                    warn $"  ($arch): could not parse current hash"
                }
            }
        }

        # Linux x86_64
        let linux_hash = try {
            prefetch-hash "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
        } catch {
            warn "  Failed to prefetch Linux hash"
            null
        }

        if $linux_hash != null {
            let current = (parse-hash $content "x86_64-linux")

            if $current == $linux_hash {
                success "  x86_64-linux: up to date"
            } else if ($current | is-not-empty) {
                $content = ($content | str replace $"hash = \"($current)\"" $"hash = \"($linux_hash)\"")
                $changed = true
                success "  x86_64-linux: updated"
            } else {
                warn "  x86_64-linux: could not parse current hash"
            }
        }

        if $changed {
            $content | save -f $chrome_file
            success "  google-chrome hashes updated"
        }
    }

    update-rolling "steam" $"($packages_dir)/steam.nix" [
        {
            label: "macOS DMG"
            url: "https://cdn.cloudflare.steamstatic.com/client/installer/steam.dmg"
            pattern: "hash"
        }
    ]

    update-rolling "google-drive" $"($packages_dir)/google-drive.nix" [
        {
            label: "macOS DMG"
            url: "https://dl.google.com/drive-file-stream/5-percent/GoogleDrive.dmg"
            pattern: "hash"
        }
    ]

    print ""

    # ── Versioned packages ────────────────────────────────────────────
    # Check Homebrew API for new versions, prefetch if changed.

    update-versioned "gpg-suite" "gpg-suite" $"($packages_dir)/gpg-suite.nix" {|version|
        [{ label: "macOS DMG", url: $"https://releases.gpgtools.org/GPG_Suite-($version).dmg", pattern: "hash" }]
    }

    update-versioned "nordvpn" "nordvpn" $"($packages_dir)/nordvpn.nix" {|version|
        [{ label: "macOS PKG", url: $"https://downloads.nordcdn.com/apps/macos/generic/NordVPN-OpenVPN/($version)/NordVPN.pkg", pattern: "hash" }]
    }

    update-versioned "zoom" "zoom" $"($packages_dir)/zoom.nix" {|version|
        [
            { label: "arm64", url: $"https://cdn.zoom.us/prod/($version)/arm64/zoomusInstallerFull.pkg", pattern: '"aarch64"' }
            { label: "x86_64", url: $"https://cdn.zoom.us/prod/($version)/zoomusInstallerFull.pkg", pattern: '"x86_64"' }
        ]
    }

    print ""
    success "Custom app updates complete"

    if not $skip_rebuild {
        print ""
        info "Run 'rebuild --skip-updates' to apply changes."
    }
}
