#!/usr/bin/env nu
# Manage the optional ~/.env.dotfiles fallback used by SecretSpec.
#
# SecretSpec + 1Password is the primary secret store. This file should only
# contain OP_SERVICE_ACCOUNT_TOKEN when keyring is unavailable or being reset.

def ensure_env_file [env_file: string] {
    if ($env_file | path exists) {
        chmod 600 $env_file
        return
    }

    let example = "Configs/secretspec/.env.dotfiles.example"
    if ($example | path exists) {
        open $example | save -f $env_file
    } else {
        [
            "## Optional SecretSpec fallback for the 1Password service account token"
            "## Prefer keyring/keychain; uncomment only when you need dotenv fallback."
            "# OP_SERVICE_ACCOUNT_TOKEN=\"readonly-service-account\""
            ""
        ] | str join "\n" | save -f $env_file
    }
    chmod 600 $env_file
}

def without_token_line [env_file: string] {
    if not ($env_file | path exists) {
        return []
    }

    open $env_file
    | lines
    | where { |line| not (($line | str trim) | str starts-with "OP_SERVICE_ACCOUNT_TOKEN=") }
}

def main [
    --set-token # Prompt for OP_SERVICE_ACCOUNT_TOKEN and write it to ~/.env.dotfiles.
] {
    let env_file = $"($env.HOME)/.env.dotfiles"
    ensure_env_file $env_file

    if not $set_token {
        print "SecretSpec + 1Password now manages dotfiles secrets."
        print $"Created/verified optional fallback file: ($env_file)"
        print ""
        print "Use:"
        print "  ss check          # verify declared secrets"
        print "  ssr <command>     # run a command with secrets injected lazily"
        print ""
        print "If you need dotenv fallback for the 1Password service account token:"
        print "  setup:env --set-token"
        return
    }

    print "Paste OP_SERVICE_ACCOUNT_TOKEN for dotenv fallback. Input is hidden."
    let token = (input --suppress-output "OP_SERVICE_ACCOUNT_TOKEN: " | str trim)
    if ($token | is-empty) {
        print "No token entered; leaving file unchanged."
        return
    }

    let backup_file = $"($env_file).backup.(date now | format date '%Y%m%d_%H%M%S')"
    cp $env_file $backup_file

    let lines = (without_token_line $env_file)
    let updated = ($lines | append $'OP_SERVICE_ACCOUNT_TOKEN="($token)"' | str join "\n")
    $updated | save -f $env_file
    chmod 600 $env_file

    print $"Updated ($env_file) and created backup: ($backup_file)"
    print "Prefer keyring/keychain for normal use; dotenv is only a fallback."
}
