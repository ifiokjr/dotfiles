#!/usr/bin/env bash
#
# Interactive environment setup script
#
# This script helps you configure your .env.dotfiles file by
# interactively prompting for each API key and token with
# instructions on where to obtain them.

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

print_header() {
    echo -e "${BOLD}${CYAN}==>${NC} ${BOLD}$1${NC}"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_info() {
    echo -e "${BLUE}→${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}!${NC} $1"
}

# Configuration
ENV_FILE="$HOME/.env.dotfiles"
BACKUP_FILE="${ENV_FILE}.backup.$(date +%Y%m%d_%H%M%S)"

# Check if .env.dotfiles exists
check_existing_env() {
    if [ -f "$ENV_FILE" ]; then
        echo ""
        print_warning "Found existing .env.dotfiles file"
        print_info "Location: $ENV_FILE"
        echo ""

        read -p "$(echo -e "${CYAN}?${NC} Do you want to update it? (This will create a backup) [y/N]: ")" response
        case "$response" in
            [Yy]|[Yy][Ee][Ss])
                # Create backup
                cp "$ENV_FILE" "$BACKUP_FILE"
                print_success "Backup created: $BACKUP_FILE"

                # Load existing values
                # shellcheck disable=SC1090
                source "$ENV_FILE"
                return 0
                ;;
            *)
                print_info "Exiting without changes"
                exit 0
                ;;
        esac
    fi
}

# Prompt for a value
prompt_for_value() {
    local var_name="$1"
    local description="$2"
    local url="$3"
    local current_value="${4:-}"
    local value=""

    # All informational output goes to stderr so it's not captured by command substitution
    echo "" >&2
    print_header "$var_name" >&2
    echo -e "${BOLD}Description:${NC} $description" >&2
    echo -e "${BOLD}Get it from:${NC} ${CYAN}$url${NC}" >&2
    echo "" >&2

    if [ -n "$current_value" ]; then
        # Mask the current value for security
        local masked_value="${current_value:0:4}...${current_value: -4}"
        print_info "Current value: $masked_value" >&2
        echo "" >&2
        read -p "$(echo -e "${CYAN}?${NC} Keep current value? [Y/n]: ")" keep_current
        case "$keep_current" in
            [Nn]|[Nn][Oo])
                # Continue to prompt for new value
                ;;
            *)
                # Only the actual value goes to stdout
                echo "$current_value"
                return 0
                ;;
        esac
    fi

    while true; do
        read -p "$(echo -e "${CYAN}?${NC} Enter $var_name (or press Enter to skip): ")" value

        if [ -z "$value" ]; then
            print_warning "Skipping $var_name (will be empty)" >&2
            echo "" >&2
            # Return empty string to stdout
            echo ""
            return 0
        fi

        # Confirm the value
        echo "" >&2
        print_info "You entered: ${value:0:20}..." >&2 # Show first 20 chars only
        read -p "$(echo -e "${CYAN}?${NC} Is this correct? [Y/n]: ")" confirm
        case "$confirm" in
            [Nn]|[Nn][Oo])
                echo "Let's try again..." >&2
                continue
                ;;
            *)
                # Only the actual value goes to stdout
                echo "$value"
                return 0
                ;;
        esac
    done
}

# Main setup flow
main() {
    echo ""
    echo -e "${BOLD}${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}${CYAN}║                                        ║${NC}"
    echo -e "${BOLD}${CYAN}║    Environment Setup Assistant        ║${NC}"
    echo -e "${BOLD}${CYAN}║                                        ║${NC}"
    echo -e "${BOLD}${CYAN}╚════════════════════════════════════════╝${NC}"
    echo ""

    print_info "This script will help you set up your environment variables"
    print_info "File: $ENV_FILE"

    check_existing_env

    echo ""
    print_header "Let's configure your environment variables"
    print_info "You can skip any value by pressing Enter"

    # GitHub Token
    GITHUB_TOKEN=$(prompt_for_value \
        "GITHUB_TOKEN" \
        "Personal access token for GitHub API access (repos, packages, etc.)" \
        "https://github.com/settings/tokens/new" \
        "$GITHUB_TOKEN")

    # OpenAI API Key
    OPENAI_API_KEY=$(prompt_for_value \
        "OPENAI_API_KEY" \
        "API key for OpenAI services (GPT, DALL-E, Whisper, etc.)" \
        "https://platform.openai.com/api-keys" \
        "$OPENAI_API_KEY")

    # Anthropic API Key (Claude)
    ANTHROPIC_API_KEY=$(prompt_for_value \
        "ANTHROPIC_API_KEY" \
        "API key for Anthropic Claude AI services" \
        "https://console.anthropic.com/settings/keys" \
        "$ANTHROPIC_API_KEY")

    # Discord Token
    DISCORD_TOKEN=$(prompt_for_value \
        "DISCORD_TOKEN" \
        "Bot token for Discord bot applications" \
        "https://discord.com/developers/applications" \
        "$DISCORD_TOKEN")

    # Google API Key
    GOOGLE_API_KEY=$(prompt_for_value \
        "GOOGLE_API_KEY" \
        "API key for Google services (Maps, Cloud, Gemini, etc.)" \
        "https://console.cloud.google.com/apis/credentials" \
        "$GOOGLE_API_KEY")

    # Replicate API Token
    REPLICATE_API_TOKEN=$(prompt_for_value \
        "REPLICATE_API_TOKEN" \
        "API token for Replicate AI model hosting and inference" \
        "https://replicate.com/account/api-tokens" \
        "$REPLICATE_API_TOKEN")

    # Hugging Face Token
    HUGGING_FACE_TOKEN=$(prompt_for_value \
        "HUGGING_FACE_TOKEN" \
        "Access token for Hugging Face model hub and inference API" \
        "https://huggingface.co/settings/tokens" \
        "$HUGGING_FACE_TOKEN")

    # Write to file
    echo ""
    print_header "Saving configuration"

    cat > "$ENV_FILE" <<EOF
GITHUB_TOKEN="$GITHUB_TOKEN"
OPENAI_API_KEY="$OPENAI_API_KEY"
ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY"
DISCORD_TOKEN="$DISCORD_TOKEN"
GOOGLE_API_KEY="$GOOGLE_API_KEY"
REPLICATE_API_TOKEN="$REPLICATE_API_TOKEN"
HUGGING_FACE_TOKEN="$HUGGING_FACE_TOKEN"
EOF

    # Set secure permissions
    chmod 600 "$ENV_FILE"

    print_success "Environment file created: $ENV_FILE"
    print_success "File permissions set to 600 (read/write for user only)"

    if [ -f "$BACKUP_FILE" ]; then
        print_info "Backup available at: $BACKUP_FILE"
    fi

    echo ""
    print_header "Next Steps"
    echo -e "  ${CYAN}1.${NC} Open a new terminal window to reload environment"
    echo -e "  ${CYAN}2.${NC} Your environment variables are now available"
    echo -e "  ${CYAN}3.${NC} To update values later, run: ${BOLD}setup:env${NC}"

    echo ""
    print_success "Setup complete!"
    echo ""
}

main "$@"
