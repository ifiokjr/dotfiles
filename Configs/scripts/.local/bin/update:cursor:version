#!/usr/bin/env nu
# Update cursor-cli to the latest version
#
# This script:
# 1. Fetches the latest cursor CLI version from the install script
# 2. Updates cursor-cli.nix with the new version and hashes
# 3. Optionally rebuilds the Darwin configuration

use nu_modules/print_utils.nu *

def main [
    --skip-rebuild  # Skip the rebuild step after updating
] {
    let nix_file = $"($env.HOME)/.config/nix/packages/cursor-cli.nix"

    if not ($nix_file | path exists) {
        err $"Could not find cursor-cli.nix at: ($nix_file)"
        exit 1
    }

    info "Checking for latest cursor-cli version..."

    # The install script at cursor.com/install contains the version string
    # in the DOWNLOAD_URL. Extract it with a regex.
    let install_script = try {
        http get "https://cursor.com/install"
    } catch {
        err "Failed to fetch cursor install script"
        exit 1
    }

    let latest_version = try {
        $install_script
        | parse --regex 'downloads\.cursor\.com/lab/([^/]+)/'
        | get capture0.0
    } catch {
        err "Could not extract version from install script"
        exit 1
    }

    if ($latest_version | is-empty) {
        err "Could not extract version from install script"
        exit 1
    }

    success $"Latest cursor-cli version: ($latest_version)"

    # Get current version from nix file
    let content = (open $nix_file --raw)
    let current_version = try {
        $content | parse --regex 'version = "([^"]+)"' | get capture0.0
    } catch {
        err $"Could not extract current version from ($nix_file)"
        exit 1
    }

    info $"Current version: ($current_version)"

    if $current_version == $latest_version {
        success "Already on latest version!"
        return
    }

    print ""
    info $"Updating from ($current_version) to ($latest_version)"

    # Backup the file
    let backup_file = $"($nix_file).backup"
    cp $nix_file $backup_file
    info $"Created backup: ($backup_file)"

    # Prefetch hashes for all platforms
    let platforms = [
        { os: "darwin", arch: "arm64", key: "darwin-arm64" }
        { os: "darwin", arch: "x64",   key: "darwin-x64" }
        { os: "linux",  arch: "x64",   key: "linux-x64" }
        { os: "linux",  arch: "arm64", key: "linux-arm64" }
    ]

    mut hashes: record<darwin-arm64: string, darwin-x64: string, linux-x64: string, linux-arm64: string> = {
        "darwin-arm64": "",
        "darwin-x64": "",
        "linux-x64": "",
        "linux-arm64": ""
    }

    for platform in $platforms {
        let url = $"https://downloads.cursor.com/lab/($latest_version)/($platform.os)/($platform.arch)/agent-cli-package.tar.gz"
        info $"Prefetching ($platform.key)..."

        let hash = try {
            ^nix-prefetch-url --unpack $url out+err>| lines | last | str trim
        } catch {
            err $"Failed to prefetch ($platform.key)"
            info "Restoring backup..."
            mv $backup_file $nix_file
            exit 1
        }

        # Convert to SRI format
        let sri = (^nix hash convert --hash-algo sha256 --to sri $hash | str trim)
        success $"($platform.key): ($sri)"
        $hashes = ($hashes | upsert $platform.key $sri)
    }

    # Update the nix file with new version and hashes
    let updated = (
        $content
        | str replace --regex 'version = "[^"]+"' $'version = "($latest_version)"'
        | str replace --regex '"darwin-arm64" = "[^"]*"' $'"darwin-arm64" = "($hashes.darwin-arm64)"'
        | str replace --regex '"darwin-x64" = "[^"]*"' $'"darwin-x64" = "($hashes.darwin-x64)"'
        | str replace --regex '"linux-x64" = "[^"]*"' $'"linux-x64" = "($hashes.linux-x64)"'
        | str replace --regex '"linux-arm64" = "[^"]*"' $'"linux-arm64" = "($hashes.linux-arm64)"'
    )

    $updated | save -f $nix_file
    rm -f $backup_file

    print ""
    success $"cursor-cli.nix updated to ($latest_version)"

    if $skip_rebuild {
        info "Skipping rebuild (--skip-rebuild flag). Run 'rebuild' manually."
        return
    }

    print ""
    info "Running rebuild to install the update..."
    print ""

    let rebuild_cmd = "ulimit -n 10240 && sudo darwin-rebuild switch --flake ~/.config/nix#default --impure"
    let rebuild_result = do -i { ^bash -c $rebuild_cmd }
    if ($env.LAST_EXIT_CODE == 0) {
        print ""
        success $"cursor-cli updated to ($latest_version)!"
    } else {
        err "Rebuild failed!"
        info "The nix file was updated. Try running 'rebuild' manually."
        exit 1
    }
}
