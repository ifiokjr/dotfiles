#!/usr/bin/env nu
# Update codex-cli to the latest version
#
# This script:
# 1. Fetches the latest Codex CLI release from GitHub
# 2. Updates codex-cli.nix with the new version and hashes
# 3. Optionally rebuilds the system configuration

use nu_modules/print_utils.nu *

def main [
    --skip-rebuild  # Skip the rebuild step after updating
] {
    let nix_file = $"($env.HOME)/.config/nix/packages/codex-cli.nix"

    if not ($nix_file | path exists) {
        err $"Could not find codex-cli.nix at: ($nix_file)"
        exit 1
    }

    info "Checking for latest codex-cli version..."

    # Fetch latest release tag from GitHub
    let release_info = try {
        ^gh release view --repo openai/codex --json tagName | from json
    } catch {
        err "Failed to fetch latest release from GitHub"
        exit 1
    }

    let tag_name = $release_info.tagName

    # Extract version from rust-v<version> tag
    let latest_version = try {
        $tag_name | parse --regex 'rust-v(.+)' | get capture0.0
    } catch {
        err $"Could not extract version from tag: ($tag_name)"
        exit 1
    }

    if ($latest_version | is-empty) {
        err $"Could not extract version from tag: ($tag_name)"
        exit 1
    }

    success $"Latest codex-cli version: ($latest_version)"

    # Get current version from nix file
    let content = (open $nix_file --raw)
    let current_version = try {
        $content | parse --regex 'version = "([^"]+)"' | get capture0.0
    } catch {
        err $"Could not extract current version from ($nix_file)"
        exit 1
    }

    info $"Current version: ($current_version)"

    if $current_version == $latest_version {
        success "Already on latest version!"
        return
    }

    print ""
    info $"Updating from ($current_version) to ($latest_version)"

    # Backup the file
    let backup_file = $"($nix_file).backup"
    cp $nix_file $backup_file
    info $"Created backup: ($backup_file)"

    let tag = $"rust-v($latest_version)"

    # Prefetch hashes for all platforms
    let platforms = [
        { suffix: "aarch64-apple-darwin", key: "aarch64-apple-darwin" }
        { suffix: "x86_64-apple-darwin", key: "x86_64-apple-darwin" }
        { suffix: "aarch64-unknown-linux-musl", key: "aarch64-unknown-linux-musl" }
        { suffix: "x86_64-unknown-linux-musl", key: "x86_64-unknown-linux-musl" }
    ]

    mut hashes: record<aarch64-apple-darwin: string, x86_64-apple-darwin: string, aarch64-unknown-linux-musl: string, x86_64-unknown-linux-musl: string> = {
        "aarch64-apple-darwin": "",
        "x86_64-apple-darwin": "",
        "aarch64-unknown-linux-musl": "",
        "x86_64-unknown-linux-musl": ""
    }

    for platform in $platforms {
        let url = $"https://github.com/openai/codex/releases/download/($tag)/codex-($platform.suffix).tar.gz"
        info $"Prefetching ($platform.key)..."

        let hash = try {
            ^nix-prefetch-url $url out+err>| lines | last | str trim
        } catch {
            err $"Failed to prefetch ($platform.key)"
            info "Restoring backup..."
            mv $backup_file $nix_file
            exit 1
        }

        # Convert to SRI format
        let sri = (^nix hash convert --hash-algo sha256 --to sri $hash | str trim)
        success $"($platform.key): ($sri)"
        $hashes = ($hashes | upsert $platform.key $sri)
    }

    # Update the nix file with new version and hashes
    let updated = (
        $content
        | str replace --regex 'version = "[^"]+"' $'version = "($latest_version)"'
        | str replace --regex '"aarch64-apple-darwin" = "[^"]*"' $'"aarch64-apple-darwin" = "($hashes.aarch64-apple-darwin)"'
        | str replace --regex '"x86_64-apple-darwin" = "[^"]*"' $'"x86_64-apple-darwin" = "($hashes.x86_64-apple-darwin)"'
        | str replace --regex '"aarch64-unknown-linux-musl" = "[^"]*"' $'"aarch64-unknown-linux-musl" = "($hashes.aarch64-unknown-linux-musl)"'
        | str replace --regex '"x86_64-unknown-linux-musl" = "[^"]*"' $'"x86_64-unknown-linux-musl" = "($hashes.x86_64-unknown-linux-musl)"'
    )

    $updated | save -f $nix_file
    rm -f $backup_file

    print ""
    success $"codex-cli.nix updated to ($latest_version)"

    if $skip_rebuild {
        info "Skipping rebuild (--skip-rebuild flag). Run 'rebuild' manually."
        return
    }

    print ""
    info "Running rebuild to install the update..."
    print ""

    # Use the cross-platform rebuild script
    let rebuild_result = do -i { ^rebuild }
    if ($env.LAST_EXIT_CODE == 0) {
        print ""
        success $"codex-cli updated to ($latest_version)!"
    } else {
        err "Rebuild failed!"
        info "The nix file was updated. Try running 'rebuild' manually."
        exit 1
    }
}
