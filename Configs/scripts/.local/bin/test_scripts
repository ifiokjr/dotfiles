#!/usr/bin/env nu
# Run test suite for custom scripts and modules
#
# Validates that all scripts:
# 1. Parse without errors (via --help)
# 2. Shared modules load correctly
# 3. Non-destructive functional tests pass

use nu_modules/print_utils.nu *
use nu_modules/platform.nu
use nu_modules/nix_config.nu

def run_test [name: string, test: closure] {
    print $"  Testing: ($name)..."
    try {
        do $test
        print $"  (ansi green)PASS(ansi reset): ($name)"
        true
    } catch { |e|
        print $"  (ansi red)FAIL(ansi reset): ($name)"
        print $"    Error: ($e.msg)"
        false
    }
}

def main [] {
    let bin_dir = ($env.FILE_PWD)
    let repo_dir = ($bin_dir | path dirname | path dirname | path dirname | path dirname)
    mut passed = 0
    mut failed = 0

    header "Script Migration Test Suite"
    print ""

    # ── Module Tests ──────────────────────────────────────────────
    info "Testing shared modules..."

    if (run_test "print_utils: info, success, err, warn, header" { ||
        info "test"
        success "test"
        err "test"
        warn "test"
        header "test"
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "platform: os detection" { ||
        let os = (platform os)
        if $os not-in ["darwin" "linux"] {
            error make { msg: $"unexpected os: ($os)" }
        }
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "platform: arch detection" { ||
        let arch = (platform arch)
        if $arch not-in ["aarch64" "x86_64"] {
            error make { msg: $"unexpected arch: ($arch)" }
        }
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "platform: nix-system" { ||
        let system = (platform nix-system)
        if $system not-in ["aarch64-darwin" "x86_64-darwin" "aarch64-linux" "x86_64-linux"] {
            error make { msg: $"unexpected system: ($system)" }
        }
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "platform: detect-hostname" { ||
        let hostname = (platform detect-hostname)
        if ($hostname | is-empty) {
            error make { msg: "hostname is empty" }
        }
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "nix_config: config-dir" { ||
        let dir = (nix_config config-dir)
        if ($dir | is-empty) {
            error make { msg: "config-dir is empty" }
        }
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "nix_config: machine-config-path" { ||
        let path = (nix_config machine-config-path)
        if not ($path | str ends-with "machine.nix") {
            error make { msg: $"unexpected path: ($path)" }
        }
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "nix_config: flake-dir fallback to repo checkout" { ||
        let temp_home = "/tmp/test-flake-dir-home"
        if ($temp_home | path exists) { rm -rf $temp_home }
        mkdir $temp_home

        let resolved = (with-env { HOME: $temp_home } { nix_config flake-dir })
        if not ($resolved | str ends-with "Configs/nix/.config/nix") {
            error make { msg: $"unexpected fallback flake-dir: ($resolved)" }
        }

        rm -rf $temp_home
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "monosecret: msr and msload require --reason" { ||
        let module_path = ($repo_dir | path join "Configs/nushell/.config/nushell/modules/secrets.nu")
        let shell_path = ($repo_dir | path join "Configs/shell/.config/shell/secrets.sh")
        let nushell_commands = [
            $"use ($module_path) [msr]; msr echo"
            $"use ($module_path) [msload]; msload"
        ]
        for command in $nushell_commands {
            let result = (^nu --no-config-file -c $command | complete)
            if $result.exit_code == 0 or not ($result.stderr | str contains "--reason <text> is required") {
                error make { msg: $"Nushell wrapper did not require --reason: ($result.stderr)" }
            }
        }

        for command in ["msr echo" "msload" "msr --reason '   ' echo" "msload --reason '   '"] {
            let result = (^sh -c $". ($shell_path); ($command)" | complete)
            if $result.exit_code != 2 or not ($result.stderr | str contains "--reason <text>") {
                error make { msg: $"POSIX wrapper did not require --reason: ($result.stderr)" }
            }
        }
    }) { $passed += 1 } else { $failed += 1 }

    print ""

    # ── Script Parse Tests (--help) ───────────────────────────────
    info "Testing script parsing via --help..."

    let scripts = [
        "commands"
        "rebuild"
        "generate-machine-config"
        "install:helix:custom"
        "update:node"
        "setup:env"
    ]

    for script in $scripts {
        let script_path = $"($bin_dir)/($script)"
        if (run_test $"($script) --help" { ||
            let result = (^nu $script_path --help)
            if ($result | str contains "Usage:") {
                # pass
            } else {
                error make { msg: "no Usage: in help output" }
            }
        }) { $passed += 1 } else { $failed += 1 }
    }

    print ""

    # ── Functional Tests ──────────────────────────────────────────
    info "Testing non-destructive functionality..."

    if (run_test "generate-machine-config --output /tmp/test-machine.nix" { ||
        ^nu $"($bin_dir)/generate-machine-config" --output /tmp/test-machine.nix --force
        let content = (open /tmp/test-machine.nix --raw)
        if not ($content | str contains "username =") {
            error make { msg: "missing username in generated file" }
        }
        if not ($content | str contains "system =") {
            error make { msg: "missing system in generated file" }
        }
        if not ($content | str contains "hostname =") {
            error make { msg: "missing hostname in generated file" }
        }
        rm /tmp/test-machine.nix
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "generate-machine-config detects existing file" { ||
        # Create a test file
        "test" | save -f /tmp/test-machine-exists.nix
        let result = (^nu $"($bin_dir)/generate-machine-config" --output /tmp/test-machine-exists.nix | str trim)
        # Without --force, it should warn about existing file
        rm /tmp/test-machine-exists.nix
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "nix_config: parse-machine-config" { ||
        let config_path = (nix_config machine-config-path)
        if ($config_path | path exists) {
            let config = (nix_config parse-machine-config)
            if ($config.username | is-empty) {
                error make { msg: "username is empty" }
            }
            if ($config.system | is-empty) {
                error make { msg: "system is empty" }
            }
            if (($config.lite | describe) != "bool") {
                error make { msg: "lite should be bool" }
            }
        }
        # Skip if machine.nix doesn't exist (CI environments)
    }) { $passed += 1 } else { $failed += 1 }

    if (run_test "nix_config: set-lite-mode true/false" { ||
        let test_file = "/tmp/test-machine-lite.nix"
        let base = "# Machine-specific configuration
{
  username = \"testuser\";
  system = \"x86_64-linux\";
  hostname = \"test-host\";
}
"
        $base | save -f $test_file

        nix_config set-lite-mode true --path $test_file
        let content_true = (open $test_file --raw)
        if not ($content_true | str contains "lite = true;") {
            error make { msg: "expected lite = true after set-lite-mode true" }
        }

        nix_config set-lite-mode false --path $test_file
        let content_false = (open $test_file --raw)
        if not ($content_false | str contains "lite = false;") {
            error make { msg: "expected lite = false after set-lite-mode false" }
        }

        rm $test_file
    }) { $passed += 1 } else { $failed += 1 }

    # ── Summary ───────────────────────────────────────────────────
    print ""
    header "Test Results"
    let total = $passed + $failed
    if $failed == 0 {
        success $"All ($total) tests passed!"
    } else {
        err $"($failed) of ($total) tests failed"
        exit 1
    }
}
