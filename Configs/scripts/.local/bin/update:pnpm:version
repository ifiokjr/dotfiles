#!/usr/bin/env nu
# Automatically update pnpm-standalone to the latest version
#
# This script:
# 1. Fetches the latest pnpm version from GitHub releases
# 2. Updates pnpm-standalone.nix with the new version
# 3. Runs update-pnpm-hash.sh to fetch and update hashes for all platforms
# 4. Rebuilds the system configuration

use nu_modules/print_utils.nu *

def main [
    --skip-rebuild  # Skip the rebuild step after updating
] {
    let nix_packages_dir = $"($env.HOME)/.config/nix/packages"
    let nix_file = $"($nix_packages_dir)/pnpm-standalone.nix"
    let update_hash_script = $"($nix_packages_dir)/update-pnpm-hash.sh"

    if not ($nix_file | path exists) {
        err $"Could not find pnpm-standalone.nix at: ($nix_file)"
        exit 1
    }

    if not ($update_hash_script | path exists) {
        err $"Could not find update-pnpm-hash.sh at: ($update_hash_script)"
        exit 1
    }

    info "Checking for latest pnpm version..."

    # Fetch latest version from GitHub API (nushell parses JSON natively)
    let latest_version = try {
        http get "https://api.github.com/repos/pnpm/pnpm/releases/latest"
        | get tag_name
        | str replace "v" ""
    } catch {
        err "Failed to fetch latest version from GitHub"
        exit 1
    }

    if ($latest_version | is-empty) {
        err "Failed to fetch latest version from GitHub"
        exit 1
    }

    success $"Latest pnpm version: ($latest_version)"

    # Get current version from nix file
    let content = (open $nix_file --raw)
    let current_version = try {
        $content | parse --regex 'version = "([^"]+)"' | get capture0.0
    } catch {
        err $"Could not extract current version from ($nix_file)"
        exit 1
    }

    if ($current_version | is-empty) {
        err $"Could not extract current version from ($nix_file)"
        exit 1
    }

    info $"Current version: ($current_version)"

    # Check if update is needed
    if $current_version == $latest_version {
        success "Already on latest version!"
        print ""
        info "Verifying pnpm installation..."
        if (which pnpm | is-not-empty) {
            let pnpm_version = (^pnpm --version | str trim)
            success $"pnpm is installed: version ($pnpm_version)"
        } else {
            warn "pnpm command not found in PATH. Try running 'rebuild' or restart your shell."
        }
        return
    }

    print ""
    info $"Updating from ($current_version) to ($latest_version)"
    print ""

    # Backup the file
    let backup_file = $"($nix_file).backup"
    cp $nix_file $backup_file
    info $"Created backup: ($backup_file)"

    # Update the version in the file
    let updated = (
        $content
        | str replace --regex 'version = "[^"]+"' $'version = "($latest_version)"'
    )

    # Reset all platform hashes to a placeholder.
    # The update-pnpm-hash.sh script will fetch correct hashes for all platforms
    # using nix-prefetch-url and replace these placeholders.
    let updated = (
        $updated
        | str replace --regex '"macos-arm64" = [^;]*;' '"macos-arm64" = "PLACEHOLDER";'
        | str replace --regex '"macos-x64" = [^;]*;' '"macos-x64" = "PLACEHOLDER";'
        | str replace --regex '"linux-arm64" = [^;]*;' '"linux-arm64" = "PLACEHOLDER";'
        | str replace --regex '"linux-x64" = [^;]*;' '"linux-x64" = "PLACEHOLDER";'
    )

    $updated | save -f $nix_file
    success "Updated version in pnpm-standalone.nix"
    print ""

    # Fetch correct hashes for all platforms
    info "Fetching hashes for all platforms..."
    print ""
    let hash_result = do -i { ^bash $update_hash_script }
    if ($env.LAST_EXIT_CODE == 0) {
        # Clean up the version backup
        rm -f $backup_file
        print ""
        success "Hash updated successfully!"

        if $skip_rebuild {
            info "Skipping rebuild \(--skip-rebuild flag\). Run 'rebuild' manually."
        } else {
            print ""
            info $"Running rebuild to install pnpm ($latest_version)..."
            print ""

            # Use the cross-platform rebuild script
            let rebuild_result = do -i { ^rebuild --skip-updates }
            if ($env.LAST_EXIT_CODE == 0) {
                print ""
                success $"pnpm successfully updated to version ($latest_version)!"
                print ""
                info "Verifying pnpm installation..."
                if (which pnpm | is-not-empty) {
                    let pnpm_version = (^pnpm --version | str trim)
                    success $"pnpm is installed: version ($pnpm_version)"

                    print ""
                    info "Installing latest Node.js via pnpm..."
                    print ""

                    # Install latest Node.js using pnpm env
                    let node_result = do -i { ^pnpm env use --global latest }
                    if ($env.LAST_EXIT_CODE == 0) {
                        print ""
                        if (which node | is-not-empty) {
                            let node_version = (^node --version | str trim)
                            success $"Node.js is ready: version ($node_version)"
                        }
                    } else {
                        print ""
                        warn "Failed to install Node.js automatically"
                        info "You can install it manually with: pnpm env use --global latest"
                    }
                } else {
                    warn "pnpm command not found in PATH. You may need to restart your shell."
                }
            } else {
                err "Rebuild failed!"
                print ""
                warn "The version and hash were updated in pnpm-standalone.nix"
                info "Try running 'rebuild' manually to complete the installation"
                exit 1
            }
        }
    } else {
        # Hash update failed — roll back to the backed-up .nix file so the
        # derivation stays buildable with the previous version's hashes
        err "Hash update failed!"
        print ""
        info "Restoring backup..."
        mv $backup_file $nix_file
        info "Backup restored. Update was rolled back."
        exit 1
    }
}
