#!/usr/bin/env bash
#
# Automatically update pnpm-standalone to the latest version
#
# This script:
# 1. Fetches the latest pnpm version from GitHub releases
# 2. Updates pnpm-standalone.nix with the new version
# 3. Runs update-pnpm-hash.sh to fetch and update the hash
# 4. Rebuilds the Darwin configuration

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_info() {
    echo -e "${BLUE}==>${NC} $1"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warn() {
    echo -e "${YELLOW}!${NC} $1"
}

# Get the nix packages directory
NIX_PACKAGES_DIR="$HOME/.config/nix/packages"
NIX_FILE="${NIX_PACKAGES_DIR}/pnpm-standalone.nix"
UPDATE_HASH_SCRIPT="${NIX_PACKAGES_DIR}/update-pnpm-hash.sh"

if [[ ! -f "$NIX_FILE" ]]; then
    print_error "Could not find pnpm-standalone.nix at: $NIX_FILE"
    exit 1
fi

if [[ ! -f "$UPDATE_HASH_SCRIPT" ]]; then
    print_error "Could not find update-pnpm-hash.sh at: $UPDATE_HASH_SCRIPT"
    exit 1
fi

print_info "Checking for latest pnpm version..."

# Fetch latest version from GitHub API (BSD grep compatible)
LATEST_VERSION=$(curl -s https://api.github.com/repos/pnpm/pnpm/releases/latest | grep '"tag_name"' | sed -E 's/.*"tag_name": "v([^"]+)".*/\1/' | head -1)

if [[ -z "$LATEST_VERSION" ]]; then
    print_error "Failed to fetch latest version from GitHub"
    exit 1
fi

print_success "Latest pnpm version: $LATEST_VERSION"

# Get current version from nix file
CURRENT_VERSION=$(grep 'version = ' "$NIX_FILE" | sed -E 's/.*version = "([^"]+)".*/\1/')

if [[ -z "$CURRENT_VERSION" ]]; then
    print_error "Could not extract current version from $NIX_FILE"
    exit 1
fi

print_info "Current version: $CURRENT_VERSION"

# Check if update is needed
if [[ "$CURRENT_VERSION" == "$LATEST_VERSION" ]]; then
    print_success "Already on latest version!"
    echo ""
    print_info "Verifying pnpm installation..."
    if command -v pnpm &> /dev/null; then
        PNPM_VERSION=$(pnpm --version)
        print_success "pnpm is installed: version $PNPM_VERSION"
    else
        print_warn "pnpm command not found in PATH. Try running 'rebuild' or restart your shell."
    fi
    exit 0
fi

echo ""
print_info "Updating from $CURRENT_VERSION to $LATEST_VERSION"
echo ""

# Backup the file
cp "$NIX_FILE" "${NIX_FILE}.backup"
print_info "Created backup: ${NIX_FILE}.backup"

# Update the version in the file
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS sed syntax
    sed -i '' "s/version = \".*\";/version = \"${LATEST_VERSION}\";/" "$NIX_FILE"
else
    # Linux sed syntax
    sed -i "s/version = \".*\";/version = \"${LATEST_VERSION}\";/" "$NIX_FILE"
fi

print_success "Updated version in pnpm-standalone.nix"
echo ""

# Set all hashes to lib.fakeSha256
print_info "Resetting hashes to trigger update..."
if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' 's/"macos-arm64" = ".*"/"macos-arm64" = lib.fakeSha256/' "$NIX_FILE"
    sed -i '' 's/"macos-x64" = ".*"/"macos-x64" = lib.fakeSha256/' "$NIX_FILE"
    sed -i '' 's/"linux-arm64" = ".*"/"linux-arm64" = lib.fakeSha256/' "$NIX_FILE"
    sed -i '' 's/"linux-x64" = ".*"/"linux-x64" = lib.fakeSha256/' "$NIX_FILE"
else
    sed -i 's/"macos-arm64" = ".*"/"macos-arm64" = lib.fakeSha256/' "$NIX_FILE"
    sed -i 's/"macos-x64" = ".*"/"macos-x64" = lib.fakeSha256/' "$NIX_FILE"
    sed -i 's/"linux-arm64" = ".*"/"linux-arm64" = lib.fakeSha256/' "$NIX_FILE"
    sed -i 's/"linux-x64" = ".*"/"linux-x64" = lib.fakeSha256/' "$NIX_FILE"
fi

echo ""
print_info "Running update-pnpm-hash.sh to fetch correct hash..."
echo ""

# Run the hash update script
if bash "$UPDATE_HASH_SCRIPT"; then
    # Clean up the version backup (hash script makes its own backup)
    rm "${NIX_FILE}.backup" 2>/dev/null || true
    echo ""
    print_success "Hash updated successfully!"
    echo ""
    print_info "Running rebuild to install pnpm $LATEST_VERSION..."
    echo ""

    # Run rebuild (requires sudo)
    if ulimit -n 10240 && sudo darwin-rebuild switch --flake ~/.config/nix#$(whoami); then
        echo ""
        print_success "pnpm successfully updated to version $LATEST_VERSION!"
        echo ""
        print_info "Verifying pnpm installation..."
        if command -v pnpm &> /dev/null; then
            PNPM_VERSION=$(pnpm --version)
            print_success "pnpm is installed: version $PNPM_VERSION"

            echo ""
            print_info "Installing latest Node.js via pnpm..."
            echo ""

            # Install latest Node.js using pnpm env
            if pnpm env use --global latest 2>&1; then
                echo ""
                if command -v node &> /dev/null; then
                    NODE_VERSION=$(node --version)
                    print_success "Node.js is ready: version $NODE_VERSION"
                fi
            else
                echo ""
                print_warn "Failed to install Node.js automatically"
                print_info "You can install it manually with: pnpm env use --global latest"
            fi
        else
            print_warn "pnpm command not found in PATH. You may need to restart your shell."
        fi
    else
        print_error "Rebuild failed!"
        echo ""
        print_warn "The version and hash were updated in pnpm-standalone.nix"
        print_info "Try running 'rebuild' manually to complete the installation"
        exit 1
    fi
else
    print_error "Hash update failed!"
    echo ""
    print_info "Restoring backup..."
    mv "${NIX_FILE}.backup" "$NIX_FILE"
    print_info "Backup restored. Update was rolled back."
    exit 1
fi
