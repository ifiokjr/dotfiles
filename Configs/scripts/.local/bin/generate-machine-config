#!/usr/bin/env nu
# Generate machine.nix configuration file
# Auto-detects username, system architecture, and hostname

use nu_modules/print_utils.nu *
use nu_modules/platform.nu
use nu_modules/nix_config.nu

def main [
    --force(-f)           # Overwrite existing machine.nix
    --output(-o): string  # Write to specific file (default: ~/.config/nix/machine.nix)
] {
    let output_file = ($output | default (nix_config machine-config-path))

    # Check if file exists and force not set
    if ($output_file | path exists) and (not $force) {
        warn $"machine.nix already exists at: ($output_file)"
        print ""
        print "Current configuration:"
        open $output_file --raw | print
        print ""
        info "Use --force to overwrite"
        return
    }

    # Auto-detect values
    let username = ($env.USER? | default (^whoami | str trim))
    let system = (platform nix-system)
    let hostname = (platform detect-hostname)

    # Validate
    if ($username | is-empty) {
        err "Failed to detect username"
        exit 1
    }
    if ($system | is-empty) {
        err "Failed to detect system architecture"
        exit 1
    }

    # Ensure output directory exists
    mkdir ($output_file | path dirname)

    # Generate machine.nix
    info "Generating machine configuration..."
    print $"  Username: ($username)"
    print $"  System: ($system)"
    print $"  Hostname: ($hostname)"
    print ""

    let content = $"# Machine-specific configuration
# Auto-generated by generate-machine-config
# This file is gitignored and will not be committed
{
  # Your username on this machine
  username = \"($username)\";

  # System architecture
  system = \"($system)\";

  # Machine hostname
  hostname = \"($hostname)\";
}
"

    $content | save -f $output_file
    success $"Created machine.nix at: ($output_file)"
    print ""
    info "Configuration:"
    open $output_file --raw | print
}
