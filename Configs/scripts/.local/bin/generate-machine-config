#!/usr/bin/env bash
# Generate machine.nix configuration file
# Auto-detects username, system architecture, and hostname

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_info() { echo -e "${BLUE}==>${NC} $1"; }
print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1"; }
print_warn() { echo -e "${YELLOW}!${NC} $1"; }

# Configuration paths
NIX_CONFIG="${NIX_CONFIG_DIR:-$HOME/.config/nix}"
MACHINE_CONFIG="$NIX_CONFIG/machine.nix"

# Parse arguments
FORCE=false
OUTPUT_FILE="$MACHINE_CONFIG"

while [[ $# -gt 0 ]]; do
    case $1 in
        --force|-f)
            FORCE=true
            shift
            ;;
        --output|-o)
            OUTPUT_FILE="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: generate-machine-config [OPTIONS]"
            echo ""
            echo "Generate machine.nix configuration file with auto-detected values"
            echo ""
            echo "Options:"
            echo "  --force, -f       Overwrite existing machine.nix"
            echo "  --output FILE     Write to specific file (default: ~/.config/nix/machine.nix)"
            echo "  --help, -h        Show this help message"
            echo ""
            echo "The script auto-detects:"
            echo "  - Username from \$USER"
            echo "  - System architecture from uname"
            echo "  - Hostname from hostname or scutil"
            exit 0
            ;;
        *)
            print_error "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Check if file exists and force not set
if [ -f "$OUTPUT_FILE" ] && [ "$FORCE" = false ]; then
    print_warn "machine.nix already exists at: $OUTPUT_FILE"
    echo ""
    echo "Current configuration:"
    cat "$OUTPUT_FILE"
    echo ""
    print_info "Use --force to overwrite"
    exit 0
fi

# Auto-detect values
USERNAME="${USER}"

# Get better hostname on macOS
if [[ "$OSTYPE" == "darwin"* ]]; then
    HOSTNAME=$(scutil --get ComputerName 2>/dev/null || hostname -s 2>/dev/null || hostname)
else
    HOSTNAME="${HOSTNAME:-$(hostname -s 2>/dev/null || hostname)}"
fi

# Detect system architecture
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS
    ARCH=$(uname -m)
    if [[ "$ARCH" == "arm64" ]]; then
        SYSTEM="aarch64-darwin"
    else
        SYSTEM="x86_64-darwin"
    fi
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    # Linux
    ARCH=$(uname -m)
    if [[ "$ARCH" == "x86_64" ]]; then
        SYSTEM="x86_64-linux"
    elif [[ "$ARCH" == "aarch64" ]] || [[ "$ARCH" == "arm64" ]]; then
        SYSTEM="aarch64-linux"
    else
        print_error "Unsupported architecture: $ARCH"
        exit 1
    fi
else
    print_error "Unsupported OS: $OSTYPE"
    exit 1
fi

# Validate detected values
if [ -z "$USERNAME" ]; then
    print_error "Failed to detect username"
    exit 1
fi

if [ -z "$SYSTEM" ]; then
    print_error "Failed to detect system architecture"
    exit 1
fi

# Create output directory if it doesn't exist
mkdir -p "$(dirname "$OUTPUT_FILE")"

# Generate machine.nix
print_info "Generating machine configuration..."
echo "  Username: $USERNAME"
echo "  System: $SYSTEM"
echo "  Hostname: $HOSTNAME"
echo ""

cat > "$OUTPUT_FILE" << EOF
# Machine-specific configuration
# Auto-generated by generate-machine-config
# This file is gitignored and will not be committed
{
  # Your username on this machine
  username = "$USERNAME";

  # System architecture
  system = "$SYSTEM";

  # Machine hostname
  hostname = "$HOSTNAME";
}
EOF

print_success "Created machine.nix at: $OUTPUT_FILE"
echo ""
print_info "Configuration:"
cat "$OUTPUT_FILE"
