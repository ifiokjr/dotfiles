#!/usr/bin/env nu
# Update racket-minimal to the latest version
#
# This script:
# 1. Fetches the latest racket version from GitHub releases
# 2. Prefetches hashes for all 4 platforms
# 3. Updates racket-minimal.nix with the new version and hashes
# 4. Optionally rebuilds the system configuration

use nu_modules/print_utils.nu *

def main [
    --skip-rebuild  # Skip the rebuild step after updating
] {
    let nix_file = $"($env.HOME)/.config/nix/packages/racket-minimal.nix"

    if not ($nix_file | path exists) {
        err $"Could not find racket-minimal.nix at: ($nix_file)"
        exit 1
    }

    info "Checking for latest racket version..."

    # Fetch latest version from GitHub API
    let latest_version = try {
        http get "https://api.github.com/repos/racket/racket/releases/latest"
        | get tag_name
        | str replace "v" ""
    } catch {
        err "Failed to fetch latest version from GitHub"
        exit 1
    }

    if ($latest_version | is-empty) {
        err "Failed to fetch latest version from GitHub"
        exit 1
    }

    success $"Latest racket version: ($latest_version)"

    # Get current version from nix file
    let content = (open $nix_file --raw)
    let current_version = try {
        $content | parse --regex 'version = "([^"]+)"' | get capture0.0
    } catch {
        err $"Could not extract current version from ($nix_file)"
        exit 1
    }

    info $"Current version: ($current_version)"

    if $current_version == $latest_version {
        success "Already on latest version!"
        return
    }

    print ""
    info $"Updating from ($current_version) to ($latest_version)"

    # Backup the file
    let backup_file = $"($nix_file).backup"
    cp $nix_file $backup_file
    info $"Created backup: ($backup_file)"

    # Prefetch hashes for all platforms
    let platforms = [
        { arch: "aarch64", os: "macosx", key: "aarch64-macosx" }
        { arch: "x86_64",  os: "macosx", key: "x86_64-macosx" }
        { arch: "aarch64", os: "linux-buster", key: "aarch64-linux-buster" }
        { arch: "x86_64",  os: "linux-buster", key: "x86_64-linux-buster" }
    ]

    mut hashes: record<aarch64-macosx: string, x86_64-macosx: string, aarch64-linux-buster: string, x86_64-linux-buster: string> = {
        "aarch64-macosx": "",
        "x86_64-macosx": "",
        "aarch64-linux-buster": "",
        "x86_64-linux-buster": ""
    }

    for platform in $platforms {
        let url = $"https://mirror.racket-lang.org/installers/($latest_version)/racket-minimal-($latest_version)-($platform.arch)-($platform.os)-cs.tgz"
        info $"Prefetching ($platform.key)..."

        let hash = try {
            ^nix-prefetch-url $url out+err>| lines | last | str trim
        } catch {
            err $"Failed to prefetch ($platform.key)"
            info "Restoring backup..."
            mv $backup_file $nix_file
            exit 1
        }

        # Convert to SRI format
        let sri = (^nix hash convert --hash-algo sha256 --to sri $hash | str trim)
        success $"($platform.key): ($sri)"
        $hashes = ($hashes | upsert $platform.key $sri)
    }

    # Update the nix file with new version and hashes
    let updated = (
        $content
        | str replace --regex 'version = "[^"]+"' $'version = "($latest_version)"'
        | str replace --regex '"aarch64-macosx" = "[^"]*"' $'"aarch64-macosx" = "($hashes.aarch64-macosx)"'
        | str replace --regex '"x86_64-macosx" = "[^"]*"' $'"x86_64-macosx" = "($hashes.x86_64-macosx)"'
        | str replace --regex '"aarch64-linux-buster" = "[^"]*"' $'"aarch64-linux-buster" = "($hashes.aarch64-linux-buster)"'
        | str replace --regex '"x86_64-linux-buster" = "[^"]*"' $'"x86_64-linux-buster" = "($hashes.x86_64-linux-buster)"'
    )

    $updated | save -f $nix_file
    rm -f $backup_file

    print ""
    success $"racket-minimal.nix updated to ($latest_version)"

    if $skip_rebuild {
        info "Skipping rebuild \(--skip-rebuild flag\). Run 'rebuild' manually."
        return
    }

    print ""
    info "Running rebuild to install the update..."
    print ""

    # Use the cross-platform rebuild script
    let rebuild_result = do -i { ^rebuild --skip-updates }
    if ($env.LAST_EXIT_CODE == 0) {
        print ""
        success $"racket-minimal updated to ($latest_version)!"
    } else {
        err "Rebuild failed!"
        info "The nix file was updated. Try running 'rebuild' manually."
        exit 1
    }
}
