#!/usr/bin/env nu
# Rebuild system configuration (cross-platform)
# macOS: darwin-rebuild switch (nix-darwin + home-manager)
# Linux: home-manager switch (standalone home-manager)
# This script ensures machine.nix exists and then rebuilds the system

use nu_modules/print_utils.nu *
use nu_modules/platform.nu
use nu_modules/nix_config.nu

def main [
    --skip-check    # Skip flake check before rebuilding
    --update        # Update flake inputs (flake.lock) before rebuilding
    --lite          # Set machine.nix default to lite mode (skip GUI-heavy apps)
    --no-lite       # Set machine.nix default to full mode (include GUI-heavy apps)
] {
    let nix_config = (nix_config config-dir)
    let machine_config = $"($nix_config)/machine.nix"
    let machine_example = $"($nix_config)/machine.nix.example"

    if $lite and $no_lite {
        err "Cannot use both --lite and --no-lite"
        exit 1
    }

    # Configure GitHub access token for nix to avoid API rate limits when
    # fetching nixpkgs. Uses GITHUB_TOKEN if available (e.g. in CI).
    let user_nix_conf = $"($env.HOME)/.config/nix/nix.conf"
    if ($env | get -o GITHUB_TOKEN | is-not-empty) {
        mkdir ($user_nix_conf | path dirname)
        let has_token = if ($user_nix_conf | path exists) {
            (open $user_nix_conf | str contains "access-tokens")
        } else {
            false
        }
        if not $has_token {
            let line = $"access-tokens = github.com=($env.GITHUB_TOKEN)\n"
            $line | save --append $user_nix_conf
            info "Configured GitHub access token for nix"
        }
    }

    # Check if machine.nix exists, create if missing
    if not ($machine_config | path exists) {
        warn $"machine.nix not found at: ($machine_config)"
        print ""
        info "Auto-generating machine configuration..."
        print ""

        # Try to use generate-machine-config script
        if (which generate-machine-config | is-not-empty) {
            try {
                ^generate-machine-config
            } catch {
                err "Failed to auto-generate machine.nix"
                exit 1
            }
        } else {
            # Fallback: create directly
            let username = ($env.USER? | default (^whoami | str trim))
            let system = (platform nix-system)
            let hostname = (platform detect-hostname)

            mkdir $nix_config
            let content = $"# Machine-specific configuration
# Auto-generated by rebuild script
# This file is gitignored and will not be committed
{
  # Your username on this machine
  username = \"($username)\";

  # System architecture
  system = \"($system)\";

  # Machine hostname
  hostname = \"($hostname)\";
}
"
            $content | save -f $machine_config
            success "Created machine.nix with auto-detected values"
            print $"  Username: ($username)"
            print $"  System: ($system)"
            print $"  Hostname: ($hostname)"
        }

        print ""
        success $"machine.nix created at: ($machine_config)"
        print ""
    }

    # Persist lite mode choice into machine.nix when explicitly requested.
    if $lite {
        nix_config set-lite-mode true
        success "Updated machine.nix default: lite = true"
    } else if $no_lite {
        nix_config set-lite-mode false
        success "Updated machine.nix default: lite = false"
    }

    # Show current configuration
    info $"Reading machine configuration from: ($machine_config)"
    let config = (nix_config parse-machine-config)

    if ($config.username | is-empty) or ($config.system | is-empty) {
        err "Failed to read username or system from machine.nix"
        warn "Please check that machine.nix is properly formatted"
        exit 1
    }

    info "Configuration:"
    print $"  Username: ($config.username)"
    print $"  System: ($config.system)"
    print $"  Lite: ($config.lite)"
    print ""

    # Detect root-only nix install (Docker/containers without systemd).
    # When true, nix commands need sudo with HOME preserved.
    # If the nix daemon socket exists (e.g. manually started), sudo is not needed.
    let root_only_nix = (not ("/run/systemd/system" | path exists)) and (not ("/nix/var/nix/daemon-socket/socket" | path exists)) and ((^id -u | str trim) != "0")

    # Build the sudo prefix for nix commands when running root-only nix.
    # Nix binaries are symlinked to /usr/local/bin by setup, so PATH isn't needed.
    let sudo_prefix = if $root_only_nix { "sudo" } else { "" }

    # Use resolved flake dir for nix commands so symlinked flake.nix doesn't produce invalid paths
    let flake_dir = (nix_config flake-dir)

    # Update flake inputs (only when --update is passed)
    if $update {
        info "Updating flake inputs..."
        let update_cmd = $"($sudo_prefix) NIX_USER_CONFIG_DIR='($nix_config)' nix flake update --flake '($flake_dir)'"
        let update_result = do -i { ^bash -c $update_cmd }
        if ($env.LAST_EXIT_CODE == 0) {
            success "Flake lock updated"
        } else {
            warn "Flake update failed \(continuing\)"
        }
        print ""
    }

    # Check flake validity (unless skipped)
    # `nix flake check` validates the flake.nix outputs without building everything
    if not $skip_check {
        info "Checking flake configuration..."
        # `do -i` suppresses the error so we can continue even if check fails
        let check_cmd = $"($sudo_prefix) NIX_USER_CONFIG_DIR='($nix_config)' nix flake check '($flake_dir)' --impure"
        let check_result = do -i { ^bash -c $check_cmd }
        if ($env.LAST_EXIT_CODE != 0) {
            # \( and \) escape parentheses in nushell string interpolation
            warn "Flake check reported issues \(continuing anyway\)"
        }
    }

    let os = (platform os)

    if $os == "darwin" {
        # Back up /etc/shells before nix-darwin takes ownership (one-time operation).
        # nix-darwin manages /etc/shells to add nix-installed shells; the backup
        # preserves the original so it can be restored if nix-darwin is removed.
        if ("/etc/shells" | path exists) and (not ("/etc/shells.before-nix-darwin" | path exists)) {
            info "Backing up /etc/shells to /etc/shells.before-nix-darwin"
            ^sudo mv /etc/shells /etc/shells.before-nix-darwin
            success "Backed up /etc/shells"
        }

        # Rebuild darwin configuration
        info "Rebuilding nix-darwin configuration..."
        print ""

        # Prompt for sudo password up front and start a keep-alive loop.
        # The Nix build phase can take a long time, and Homebrew cask installs
        # during activation call `sudo` internally. Without this keep-alive,
        # the cached sudo credentials expire and cause an infinite "Password:"
        # prompt loop (brew retries sudo endlessly in non-interactive context).
        ^sudo -v
        # Spawn a background bash process that refreshes sudo every 50 seconds.
        # Uses nohup + /dev/null redirection to fully detach from the terminal.
        # The loop self-terminates when the parent nushell process ($nu.pid) exits.
        let keepalive_pid = $nu.pid
        ^bash -c $"nohup bash -c 'while true; do sudo -n true; sleep 50; kill -0 ($keepalive_pid) 2>/dev/null || exit; done' >/dev/null 2>&1 &"

        # On first run, `darwin-rebuild` CLI may not be installed yet.
        # Use `nix run nix-darwin` from the flake input as fallback.
        let darwin_cmd = if (which darwin-rebuild | is-not-empty) {
            $"darwin-rebuild switch --flake '($flake_dir)#default' --impure"
        } else {
            info "darwin-rebuild not found, using nix run for first-time setup..."
            $"nix run nix-darwin/master -- switch --flake '($flake_dir)#default' --impure"
        }

        # Wrap in bash -c because:
        # 1. `ulimit -n 10240` raises macOS file descriptor limit (nix builds open many files)
        # 2. `sudo` with inline env var (`NIX_USER_CONFIG_DIR`) passes the config path
        #    through to the darwin-rebuild process so it can find gitignored machine.nix
        # 3. `--impure` is needed because machine.nix is gitignored and read via env var
        let rebuild_cmd = $"ulimit -n 10240 && sudo NIX_USER_CONFIG_DIR='($nix_config)' ($darwin_cmd)"
        # `do -i` ignores errors so we can check $env.LAST_EXIT_CODE manually below
        let result = do -i { ^bash -c $rebuild_cmd }

        if ($env.LAST_EXIT_CODE == 0) {
            print ""
            success "Configuration rebuilt successfully!"
            info "Both system \(darwin\) and user \(home-manager\) configurations have been updated."
            info "You may need to restart your shell for some changes to take effect."
        } else {
            print ""
            err "Failed to rebuild configuration"
            exit 1
        }
    } else {
        # Linux: use standalone home-manager switch
        info "Rebuilding home-manager configuration..."
        print ""

        let hm_flake = $"($flake_dir)#($config.username)@($config.system)"

        # On first run, `home-manager` CLI may not be installed yet.
        # Use `nix run home-manager` from the flake input as fallback.
        let hm_cmd = if (which home-manager | is-not-empty) {
            $"home-manager switch --flake '($hm_flake)' --impure"
        } else {
            info "home-manager not found, using nix run for first-time setup..."
            $"nix run home-manager -- switch --flake '($hm_flake)' --impure"
        }

        # Explicitly pass USER and HOME so home-manager activation can verify the
        # target user. Without this, bash -c subshells may not inherit these vars.
        let rebuild_cmd = $"($sudo_prefix) USER=($config.username) HOME=($env.HOME) NIX_USER_CONFIG_DIR='($nix_config)' ($hm_cmd)"
        let result = do -i { ^bash -c $rebuild_cmd }

        if ($env.LAST_EXIT_CODE == 0) {
            print ""
            success "Configuration rebuilt successfully!"
            info "Home-manager configuration has been updated."
            info "You may need to restart your shell for some changes to take effect."
        } else {
            print ""
            err "Failed to rebuild configuration"
            exit 1
        }
    }
}
