#!/usr/bin/env bash
# Rebuild nix-darwin configuration
# This script ensures machine.nix exists and then rebuilds the system

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_info() { echo -e "${BLUE}==>${NC} $1"; }
print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1"; }
print_warn() { echo -e "${YELLOW}!${NC} $1"; }

# Configuration paths
# machine.nix should be in the actual flake directory (dotfiles repo)
# Find where the flake actually lives
if [ -L "$HOME/.config/nix" ]; then
    # If it's a symlink, get the actual path to the dotfiles repo
    NIX_CONFIG=$(readlink -f "$HOME/.config/nix" 2>/dev/null || greadlink -f "$HOME/.config/nix" 2>/dev/null || readlink "$HOME/.config/nix")
else
    NIX_CONFIG="$HOME/.config/nix"
fi
MACHINE_CONFIG="$NIX_CONFIG/machine.nix"
MACHINE_EXAMPLE="$NIX_CONFIG/machine.nix.example"

# Check if machine.nix exists, create if missing
if [ ! -f "$MACHINE_CONFIG" ]; then
    print_warn "machine.nix not found at: $MACHINE_CONFIG"
    echo ""
    print_info "Auto-generating machine configuration..."
    echo ""

    # Try to use generate-machine-config script
    if command -v generate-machine-config &> /dev/null; then
        if ! generate-machine-config; then
            print_error "Failed to auto-generate machine.nix"
            exit 1
        fi
    else
        # Fallback: create directly
        # Detect values
        AUTO_USERNAME="${USER}"

        # Get hostname
        if [[ "$OSTYPE" == "darwin"* ]]; then
            AUTO_HOSTNAME=$(scutil --get ComputerName 2>/dev/null || hostname -s 2>/dev/null || hostname)
        else
            AUTO_HOSTNAME="${HOSTNAME:-$(hostname -s 2>/dev/null || hostname)}"
        fi

        # Detect system
        if [[ "$OSTYPE" == "darwin"* ]]; then
            ARCH=$(uname -m)
            if [[ "$ARCH" == "arm64" ]]; then
                AUTO_SYSTEM="aarch64-darwin"
            else
                AUTO_SYSTEM="x86_64-darwin"
            fi
        elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
            ARCH=$(uname -m)
            if [[ "$ARCH" == "x86_64" ]]; then
                AUTO_SYSTEM="x86_64-linux"
            elif [[ "$ARCH" == "aarch64" ]] || [[ "$ARCH" == "arm64" ]]; then
                AUTO_SYSTEM="aarch64-linux"
            else
                print_error "Unsupported architecture: $ARCH"
                exit 1
            fi
        else
            print_error "Unsupported OS for auto-detection: $OSTYPE"
            exit 1
        fi

        # Create machine.nix in deployed location
        mkdir -p "$NIX_CONFIG"
        cat > "$MACHINE_CONFIG" << EOF
# Machine-specific configuration
# Auto-generated by rebuild script
# This file is gitignored and will not be committed
{
  # Your username on this machine
  username = "$AUTO_USERNAME";

  # System architecture
  system = "$AUTO_SYSTEM";

  # Machine hostname
  hostname = "$AUTO_HOSTNAME";
}
EOF

        print_success "Created machine.nix with auto-detected values"
        echo "  Username: $AUTO_USERNAME"
        echo "  System: $AUTO_SYSTEM"
        echo "  Hostname: $AUTO_HOSTNAME"
    fi

    echo ""
    print_success "machine.nix created at: $MACHINE_CONFIG"
    echo ""
fi

# Increase file descriptor limit for Nix builds
ulimit -n 10240

# Show current configuration
print_info "Reading machine configuration from: $MACHINE_CONFIG"
USERNAME=$(grep 'username = ' "$MACHINE_CONFIG" | sed 's/.*"\(.*\)".*/\1/')
SYSTEM=$(grep 'system = ' "$MACHINE_CONFIG" | sed 's/.*"\(.*\)".*/\1/')

if [ -z "$USERNAME" ] || [ -z "$SYSTEM" ]; then
    print_error "Failed to read username or system from machine.nix"
    print_warn "Please check that machine.nix is properly formatted"
    exit 1
fi

print_info "Configuration:"
echo "  Username: $USERNAME"
echo "  System: $SYSTEM"
echo ""

# Parse command line arguments
SKIP_CHECK=false
while [[ $# -gt 0 ]]; do
    case $1 in
        --skip-check)
            SKIP_CHECK=true
            shift
            ;;
        --help|-h)
            echo "Usage: rebuild [OPTIONS]"
            echo ""
            echo "Rebuild nix-darwin configuration from machine.nix"
            echo ""
            echo "Options:"
            echo "  --skip-check    Skip flake check before rebuilding"
            echo "  --help, -h      Show this help message"
            exit 0
            ;;
        *)
            print_error "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Check flake validity (unless skipped)
if [ "$SKIP_CHECK" = false ]; then
    print_info "Checking flake configuration..."
    if ! nix flake check "$NIX_CONFIG" 2>&1; then
        print_warn "Flake check reported issues (continuing anyway)"
    fi
fi

# Rebuild darwin configuration
print_info "Rebuilding nix-darwin configuration..."
echo ""

# Explicitly use #default to avoid darwin-rebuild appending username
if sudo darwin-rebuild switch --flake "$NIX_CONFIG#default"; then
    echo ""
    print_success "Configuration rebuilt successfully!"
    print_info "Both system (darwin) and user (home-manager) configurations have been updated."
    print_info "You may need to restart your shell for some changes to take effect."
else
    echo ""
    print_error "Failed to rebuild configuration"
    exit 1
fi
