#!/usr/bin/env nu
# Rebuild system configuration (cross-platform)
# macOS: nh darwin switch (nix-darwin + home-manager)
# Linux: nh home switch (standalone home-manager)
# This script ensures machine.nix exists and then rebuilds the system

use nu_modules/print_utils.nu *
use nu_modules/platform.nu
use nu_modules/nix_config.nu

def sync_pnpm_global_packages [] {
    let primary_sync_script = $"($env.HOME)/.local/bin/pnpm:global:sync"
    let fallback_sync_script = $"($env.FILE_PWD)/pnpm:global:sync"

    let sync_script = if ($primary_sync_script | path exists) {
        $primary_sync_script
    } else if ($fallback_sync_script | path exists) {
        $fallback_sync_script
    } else {
        ""
    }

    if ($sync_script | is-empty) {
        err "pnpm:global:sync not found; cannot sync managed pnpm global packages"
        exit 1
    }

    info "Syncing managed pnpm global packages..."
    do -i { ^bash $sync_script }

    if ($env.LAST_EXIT_CODE == 0) {
        success "Managed pnpm global packages synced"
    } else {
        err "Failed to sync managed pnpm global packages"
        exit 1
    }
}

def ensure_darwin_sudo_session [] {
    info "Preparing sudo session for nix-darwin..."
    ^sudo -v

    # macOS /etc/sudoers does not include /etc/sudoers.d by default, and
    # nix-darwin only creates files inside that directory without adding the
    # #includedir directive. If it is missing, all security.sudo.extraConfig
    # settings (including timestamp_type=global) are silently ignored.
    let sudoers_main = "/etc/sudoers"
    let has_includedir = do -i {
        ^sudo grep -q "#includedir.*/etc/sudoers.d" $sudoers_main
    }
    if ($env.LAST_EXIT_CODE != 0) {
        info "Bootstrapping #includedir into /etc/sudoers..."
        ^sudo cp $sudoers_main $"($sudoers_main).before-nix-darwin-includedir"
        ^sudo bash -c $"printf '\\n# nix-darwin managed extra config\\n#includedir /etc/sudoers.d\\n' >> ($sudoers_main)"
        let visudo_ok = do -i { ^sudo visudo -c -f $sudoers_main }
        if ($env.LAST_EXIT_CODE != 0) {
            err "visudo rejected the modified /etc/sudoers; restoring backup"
            ^sudo cp $"($sudoers_main).before-nix-darwin-includedir" $sudoers_main
            exit 1
        }
        success "Added #includedir /etc/sudoers.d to /etc/sudoers"
    }

    let sudoers_extra = "/etc/sudoers.d/10-nix-darwin-extra-config"
    let needs_bootstrap = if ($sudoers_extra | path exists) {
        let content = (open $sudoers_extra)
        (not ($content | str contains "timestamp_type=global")) or (not ($content | str contains "timestamp_timeout=15"))
    } else {
        true
    }

    if $needs_bootstrap {
        info "Bootstrapping global sudo timestamps with 15min timeout..."
        ^sudo bash -c $"mkdir -p /etc/sudoers.d && printf '%s\n' 'Defaults timestamp_type=global' 'Defaults timestamp_timeout=15' >> ($sudoers_extra) && chmod 0440 ($sudoers_extra)"
        success "Added timestamp_type=global and timestamp_timeout=15 to sudoers"
    }

    # Refresh the sudo ticket after any sudoers changes so Homebrew subprocesses
    # spawned from nix-darwin can reuse the cached credentials across process trees.
    ^sudo -v
}

def run_with_darwin_sudo_keepalive [command: string] {
    let wrapped_cmd = $"while true; do sudo -v >/dev/null 2>&1; sleep 30; kill -0 $$ || break; done >/dev/null 2>&1 & keepalive=$!; trap 'kill $keepalive' EXIT; ($command)"
    do -i { ^bash -c $wrapped_cmd }
}

def main [
    --help (-h)     # Show this help message and exit
    --skip-check    # Skip flake check before rebuilding
    --update        # Update flake inputs (flake.lock) before rebuilding
    --brew          # With --update on macOS, also run `brew upgrade --cask --greedy` (slow)
    --lite          # Set machine.nix default to lite mode (skip GUI-heavy apps)
    --no-lite       # Set machine.nix default to full mode (include GUI-heavy apps)
] {
    let nix_config = (nix_config config-dir)
    let machine_config = $"($nix_config)/machine.nix"
    let machine_example = $"($nix_config)/machine.nix.example"

    if $lite and $no_lite {
        err "Cannot use both --lite and --no-lite"
        exit 1
    }

    if $brew and not $update {
        err "--brew requires --update"
        exit 1
    }

    # Configure GitHub access token for nix to avoid API rate limits when
    # fetching nixpkgs. Uses GITHUB_TOKEN if available (e.g. in CI).
    let user_nix_conf = $"($env.HOME)/.config/nix/nix.conf"
    if ($env | get -o GITHUB_TOKEN | is-not-empty) {
        mkdir ($user_nix_conf | path dirname)
        let has_token = if ($user_nix_conf | path exists) {
            (open $user_nix_conf | str contains "access-tokens")
        } else {
            false
        }
        if not $has_token {
            let line = $"access-tokens = github.com=($env.GITHUB_TOKEN)\n"
            $line | save --append $user_nix_conf
            info "Configured GitHub access token for nix"
        }
    }

    # Check if machine.nix exists, create if missing
    if not ($machine_config | path exists) {
        warn $"machine.nix not found at: ($machine_config)"
        print ""
        info "Auto-generating machine configuration..."
        print ""

        # Try to use generate-machine-config script
        if (which generate-machine-config | is-not-empty) {
            try {
                ^generate-machine-config
            } catch {
                err "Failed to auto-generate machine.nix"
                exit 1
            }
        } else {
            # Fallback: create directly
            let username = ($env.USER? | default (^whoami | str trim))
            let system = (platform nix-system)
            let hostname = (platform detect-hostname)

            mkdir $nix_config
            let content = $"# Machine-specific configuration
# Auto-generated by rebuild script
# This file is gitignored and will not be committed
{
  # Your username on this machine
  username = \"($username)\";

  # System architecture
  system = \"($system)\";

  # Machine hostname
  hostname = \"($hostname)\";
}
"
            $content | save -f $machine_config
            success "Created machine.nix with auto-detected values"
            print $"  Username: ($username)"
            print $"  System: ($system)"
            print $"  Hostname: ($hostname)"
        }

        print ""
        success $"machine.nix created at: ($machine_config)"
        print ""
    }

    # Persist lite mode choice into machine.nix when explicitly requested.
    if $lite {
        nix_config set-lite-mode true
        success "Updated machine.nix default: lite = true"
    } else if $no_lite {
        nix_config set-lite-mode false
        success "Updated machine.nix default: lite = false"
    }

    # Show current configuration
    info $"Reading machine configuration from: ($machine_config)"
    let config = (nix_config parse-machine-config)

    if ($config.username | is-empty) or ($config.system | is-empty) {
        err "Failed to read username or system from machine.nix"
        warn "Please check that machine.nix is properly formatted"
        exit 1
    }

    info "Configuration:"
    print $"  Username: ($config.username)"
    print $"  System: ($config.system)"
    print $"  Lite: ($config.lite)"
    print ""

    # Detect root-only nix install (Docker/containers without systemd).
    # When true, nix commands need sudo with HOME preserved.
    # If the nix daemon socket exists (e.g. manually started), sudo is not needed.
    let root_only_nix = (not ("/run/systemd/system" | path exists)) and (not ("/nix/var/nix/daemon-socket/socket" | path exists)) and ((^id -u | str trim) != "0")

    # Build the sudo prefix for nix commands when running root-only nix.
    # Nix binaries are symlinked to /usr/local/bin by setup, so PATH isn't needed.
    let sudo_prefix = if $root_only_nix { "sudo" } else { "" }

    # Use resolved flake dir for nix commands so symlinked flake.nix doesn't produce invalid paths
    let flake_dir = (nix_config flake-dir)

    let os = (platform os)

    # Update flake inputs (only when --update is passed)
    if $update {
        info "Updating flake inputs..."
        let update_cmd = $"($sudo_prefix) NIX_USER_CONFIG_DIR='($nix_config)' nix flake update --flake '($flake_dir)'"
        let update_result = do -i { ^bash -c $update_cmd }
        if ($env.LAST_EXIT_CODE == 0) {
            success "Flake lock updated"
        } else {
            warn "Flake update failed \(continuing\)"
        }
        print ""

        # Update pnpm global dependencies to their latest compatible versions
        if (which pnpm | is-not-empty) {
            info "Updating pnpm global dependencies..."
            let pnpm_result = do -i { ^pnpm update -g -L }
            if ($env.LAST_EXIT_CODE == 0) {
                success "pnpm global dependencies updated"
            } else {
                warn "pnpm global update failed \(continuing\)"
            }
            print ""
        } else {
            warn "pnpm not found, skipping global dependency update"
        }

        if $brew {
            if $os != "darwin" {
                err "--brew is only supported on macOS"
                exit 1
            }

            if (which brew | is-not-empty) {
                info "Updating Homebrew casks with --greedy \(slow\)..."
                ensure_darwin_sudo_session
                let brew_result = run_with_darwin_sudo_keepalive "brew upgrade --cask --greedy"
                if ($env.LAST_EXIT_CODE == 0) {
                    success "Homebrew casks updated"
                } else {
                    warn "Homebrew cask upgrade failed \(continuing\)"
                }
                print ""
            } else {
                warn "brew not found, skipping Homebrew cask upgrade"
            }
        }
    }

    # Check flake validity (unless skipped)
    # `nix flake check` validates the flake.nix outputs without building everything
    if not $skip_check {
        info "Checking flake configuration..."
        # `do -i` suppresses the error so we can continue even if check fails
        let check_cmd = $"($sudo_prefix) NIX_USER_CONFIG_DIR='($nix_config)' nix flake check '($flake_dir)' --impure"
        let check_result = do -i { ^bash -c $check_cmd }
        if ($env.LAST_EXIT_CODE != 0) {
            # \( and \) escape parentheses in nushell string interpolation
            warn "Flake check reported issues \(continuing anyway\)"
        }
    }

    if $os == "darwin" {
        ensure_darwin_sudo_session

        # Back up /etc/shells before nix-darwin takes ownership (one-time operation).
        # nix-darwin manages /etc/shells to add nix-installed shells; the backup
        # preserves the original so it can be restored if nix-darwin is removed.
        if ("/etc/shells" | path exists) and (not ("/etc/shells.before-nix-darwin" | path exists)) {
            info "Backing up /etc/shells to /etc/shells.before-nix-darwin"
            ^sudo mv /etc/shells /etc/shells.before-nix-darwin
            success "Backed up /etc/shells"
        }

        # Rename bootstrapped sudoers file so nix-darwin can take ownership.
        # nix-darwin manages this file via security.sudo.extraConfig and will
        # recreate it during activation. If the file exists with content
        # nix-darwin didn't create, activation aborts.
        let sudoers_extra = "/etc/sudoers.d/10-nix-darwin-extra-config"
        if ($sudoers_extra | path exists) and (not ($"($sudoers_extra).before-nix-darwin" | path exists)) {
            info $"Renaming ($sudoers_extra) for nix-darwin activation"
            ^sudo mv $sudoers_extra $"($sudoers_extra).before-nix-darwin"
        }

        # Rebuild darwin configuration
        info "Rebuilding nix-darwin configuration with nh..."
        print ""

        # On first run, `nh` may not be installed yet.
        # Use `nix run nixpkgs#nh` as a bootstrap fallback.
        let darwin_cmd = if (which nh | is-not-empty) {
            $"nh darwin switch '($flake_dir)' -H default --impure"
        } else {
            info "nh not found, using nix run nixpkgs#nh for first-time setup..."
            $"nix run nixpkgs#nh -- darwin switch '($flake_dir)' -H default --impure"
        }

        # Wrap in bash -c because:
        # 1. `ulimit -n 10240` raises macOS file descriptor limit (nix builds open many files)
        # 2. `--impure` is needed because machine.nix is gitignored and read via env var
        # 3. a temporary sudo keepalive prevents repeated password prompts during long
        #    nix-darwin activations that invoke Homebrew in separate process trees
        # Note: nh darwin manages sudo internally; do not wrap the command in sudo.
        let rebuild_cmd = $"ulimit -n 10240 && NIX_USER_CONFIG_DIR='($nix_config)' ($darwin_cmd)"
        # `do -i` ignores errors so we can check $env.LAST_EXIT_CODE manually below
        let result = run_with_darwin_sudo_keepalive $rebuild_cmd

        if ($env.LAST_EXIT_CODE == 0) {
            print ""
            sync_pnpm_global_packages
            print ""
            success "Configuration rebuilt successfully!"
            info "Both system \(darwin\) and user \(home-manager\) configurations have been updated."
            info "You may need to restart your shell for some changes to take effect."
        } else {
            print ""
            err "Failed to rebuild configuration"
            exit 1
        }
    } else {
        # Linux: use nh home switch
        info "Rebuilding home-manager configuration with nh..."
        print ""

        let hm_configuration = $"($config.username)@($config.system)"

        # On first run, `nh` may not be installed yet.
        # Use `nix run nixpkgs#nh` as a bootstrap fallback.
        let hm_cmd = if (which nh | is-not-empty) {
            $"nh home switch '($flake_dir)' -c '($hm_configuration)' --impure"
        } else {
            info "nh not found, using nix run nixpkgs#nh for first-time setup..."
            $"nix run nixpkgs#nh -- home switch '($flake_dir)' -c '($hm_configuration)' --impure"
        }

        # Explicitly pass USER and HOME so home-manager activation can verify the
        # target user. Without this, bash -c subshells may not inherit these vars.
        let rebuild_cmd = $"($sudo_prefix) USER=($config.username) HOME=($env.HOME) NIX_USER_CONFIG_DIR='($nix_config)' ($hm_cmd)"
        let result = do -i { ^bash -c $rebuild_cmd }

        if ($env.LAST_EXIT_CODE == 0) {
            print ""
            sync_pnpm_global_packages
            print ""
            success "Configuration rebuilt successfully!"
            info "Home-manager configuration has been updated."
            info "You may need to restart your shell for some changes to take effect."
        } else {
            print ""
            err "Failed to rebuild configuration"
            exit 1
        }
    }
}
