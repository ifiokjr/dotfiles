{
	"incremental": true,
	"useTabs": true,
	"indentWidth": 2,
	"exec": {
		"commands": [
			{
				"command": "rustfmt +nightly --unstable-features --edition 2024 --config-path Configs/dprint/.rustfmt.toml",
				"exts": [
					"rs"
				]
			},
			{
				"command": "nixfmt",
				"exts": [
					"nix"
				]
			},
			{
				"command": "shfmt --filename {{file_path}} -i 0",
				"exts": [
					"sh",
					"bash",
					"zsh"
				]
			},
			{
				"command": "kdlfmt format --config ~/.config/kdl/kdlfmt.kdl --stdin",
				"exts": [
					"kdl"
				]
			},
			{
				"command": "nufmt --stdin",
				"exts": [
					"nu"
				]
			},
			{
				"command": "taplo format --config .taplo.toml --stdin-filepath {{file_path}} -",
				"exts": [
					"toml"
				]
			}
		]
	},
	"dockerfile": {},
	"typescript": {
		"deno": true,
		"useTabs": true,
		"module.sortExportDeclarations": "caseInsensitive",
		"module.sortImportDeclarations": "caseInsensitive"
	},
	"json": {
		"deno": true,
		"useTabs": true
	},
	"markdown": {
		"deno": true,
		"textWrap": "never"
	},
	"yaml": {},
	"excludes": [
		"**/pnpm-lock.yaml",
		"**/.serena/**",
		"**/dist",
		"**/.devenv/**",
		"**/fixtures",
		"**/snapshots",
		"**/target",
		"**/node_modules",
		"**/skills/**"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.95.15.wasm",
		"https://plugins.dprint.dev/json-0.21.3.wasm",
		"https://plugins.dprint.dev/markdown-0.21.1.wasm",
		"https://plugins.dprint.dev/exec-0.6.2.json@df98f54ffd3092b8a841aedd6d098a2651f16d0a796a40535774f1a8b4b9d463",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
		"https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.0.wasm",
		"https://plugins.dprint.dev/g-plane/malva-v0.15.2.wasm",
		"https://plugins.dprint.dev/dockerfile-0.3.3.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_graphql-v0.2.3.wasm",
		"https://plugins.dprint.dev/ruff-0.7.9.wasm",
		"https://plugins.dprint.dev/jupyter-0.2.2.wasm"
	]
}
