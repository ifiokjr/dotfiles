{
	"$schema": "https://opencode.ai/config.json",
	"permission": {
		"edit": "allow",
		"bash": {
			"*": "ask"
		},
		"webfetch": {
			"*": "ask"
		},
		"external_directory": {
			"*": "ask"
		}
	},
	"model": "ollama-cloud/kimi-k2.7-code",
	"share": "disabled",
	"autoupdate": false,
	"mcp": {
		"servers": {
			"cloudflare": {
				"type": "remote",
				"url": "https://mcp.cloudflare.com/mcp"
			}
		}
	}
}
