{
	"$schema": "https://opencode.ai/config.json",
	"permission": {
		"edit": "allow",
		"bash": {
			"*": "ask"
		},
		"webfetch": {
			"*": "ask"
		},
		"external_directory": {
			"*": "ask"
		}
	},
	"model": "ollama-cloud/kimi-k2.7-code",
	"share": "disabled",
	"autoupdate": false,
	"mcp": {
		"servers": {
			"cloudflare": {
				"type": "remote",
				"url": "https://mcp.cloudflare.com/mcp"
			},
			"browse": {
				"type": "local",
				"command": ["/Users/ifiokjr/Library/pnpm/bin/browse", "mcp"],
				"cwd": "/Users/ifiokjr",
				"pool": true,
				"environment": {
					"OPENCODE_BROWSER_RUNTIME": "auto-update",
					"OPENCODE_BROWSER_AUTO_UPDATE": "notify"
				}
			}
		}
	}
}
