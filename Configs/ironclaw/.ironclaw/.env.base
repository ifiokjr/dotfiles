# Ironclaw base configuration — non-secret defaults only.
# Merged into ~/.ironclaw/.env on deploy; secret values are preserved.
# Edit secrets directly in ~/.ironclaw/.env (not tracked by git).

DATABASE_BACKEND=libsql
LIBSQL_PATH=~/.ironclaw/ironclaw.db
# Keep IRONCLAW_PROFILE unset: the built-in local profile disables the web gateway.

# LLM provider configuration.
# Default: GPT-5.5 via Codex (ChatGPT subscription, medium reasoning by default).
# Ollama models disable thinking by default (IronClaw doesn't pass `think` param) —
#   use Codex for tasks that need reasoning until issue #84 is resolved.
# Switch models at runtime:
#   ironclaw models set-provider ollama && ironclaw models set glm-5.1:cloud
#   ironclaw models set-provider ollama && ironclaw models set kimi-k2.6:cloud
#   ironclaw models set-provider openai_codex && ironclaw models set gpt-5.5
LLM_BACKEND=openai_codex
LLM_USE_CODEX_AUTH=true
OPENAI_CODEX_MODEL=gpt-5.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=262144
# Available Ollama cloud models (already pulled or available via :cloud tag):
#   kimi-k2.6:cloud, glm-5.1:cloud
# Available Codex models (via ChatGPT subscription):
#   gpt-5.5, gpt-5.4, gpt-5.3-codex

AGENT_NAME=ironclaw-mini02
AGENT_MAX_PARALLEL_JOBS=3
AGENT_JOB_TIMEOUT_SECS=3600
AGENT_USE_PLANNING=true

SAFETY_INJECTION_CHECK_ENABLED=true
SAFETY_MAX_OUTPUT_LENGTH=100000

SELF_REPAIR_CHECK_INTERVAL_SECS=60
SELF_REPAIR_MAX_ATTEMPTS=3

SANDBOX_ENABLED=true
SANDBOX_POLICY=readonly
# Podman Docker compatibility: set DOCKER_HOST so sandbox finds the podman socket.
DOCKER_HOST=unix:///tmp/podman/podman-machine-default-api.sock

# Web Gateway (browser UI) on the tailnet-only service port.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=43210
GATEWAY_ENABLED=true
CLI_ENABLED=true

# Disable the webhook-only HTTP channel; it serves /health only, not the browser UI.
HTTP_ENABLED=false

RUST_LOG=ironclaw=info

# Embeddings via local Ollama (nomic-embed-text)
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Google OAuth login (enable once redirect URI is configured)
# OAUTH_ENABLED=true
# OAUTH_BASE_URL=http://localhost:43210
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
