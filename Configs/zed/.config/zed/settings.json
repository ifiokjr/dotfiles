// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"diff_view_style": "unified",
	"language_models": {
		"ollama": {
			"api_url": "http://localhost:11434"
		},
		"openai_compatible": {
			"zai": {
				"api_url": "https://api.z.ai/api/coding/paas/v4",
				"available_models": [
					{
						"name": "glm-5.3",
						"display_name": "GLM-5.3",
						"max_tokens": 1000000,
						"max_output_tokens": 128000,
						"capabilities": {
							"tools": true,
							"images": false,
							"parallel_tool_calls": true,
							"prompt_cache_key": false
						}
					},
					{
						"name": "glm-5.3-flash",
						"display_name": "GLM-5.3 Flash",
						"max_tokens": 1000000,
						"max_output_tokens": 128000,
						"capabilities": {
							"tools": true,
							"images": true,
							"parallel_tool_calls": true,
							"prompt_cache_key": false
						}
					},
					{
						"name": "glm-5.2",
						"display_name": "GLM-5.2",
						"max_tokens": 1000000,
						"max_output_tokens": 128000,
						"capabilities": {
							"tools": true,
							"images": false,
							"parallel_tool_calls": true,
							"prompt_cache_key": false
						}
					}
				]
			}
		}
	},
	"context_servers": {
		"flutter": {
			"enabled": true,
			"remote": false,
			"command": "fvm",
			"args": [
				"dart",
				"mcp-server"
			],
			"env": {}
		}
	},
	"helix_mode": true,
	"agent": {
		"sandbox_permissions": {
			"allow_all_hosts": false,
			"allow_fs_write_all": false,
			"allow_unsandboxed": false
		},
		"default_profile": "write",
		"default_model": {
			"effort": "max",
			"provider": "opencode",
			"model": "go/beam-free",
			"enable_thinking": true
		},
		"favorite_models": [
			{
				"provider": "zai",
				"model": "glm-5.3",
				"enable_thinking": true
			},
			{
				"provider": "zai",
				"model": "glm-5.3-flash",
				"enable_thinking": true
			},
			{
				"provider": "ollama",
				"model": "kimi-k3:cloud",
				"enable_thinking": true
			},
			{
				"provider": "ollama",
				"model": "kimi-k2.7-code:cloud",
				"enable_thinking": true
			},
			{
				"provider": "openai-subscribed",
				"model": "gpt-6.1-sol",
				"enable_thinking": true,
				"effort": "xhigh",
				"speed": "fast"
			},
			{
				"provider": "ollama",
				"model": "deepseek-v4.1-flash:cloud",
				"enable_thinking": true
			},
			{
				"provider": "ollama",
				"model": "deepseek-v4-pro:cloud",
				"enable_thinking": true
			},
			{
				"provider": "ollama",
				"model": "minimax-m3.1-flash:cloud",
				"enable_thinking": true
			},
			{
				"provider": "ollama",
				"model": "glm-5.2:cloud",
				"enable_thinking": true
			}
		],
		"model_parameters": [],
		"tool_permissions": {
			"default": "ask",
			"tools": {
				"search_web": {
					"default": "ask"
				},
				"terminal": {
					"default": "ask"
				}
			}
		}
	},
	"lsp": {
		"cargo-tom": {
			"initialization_options": {
				"hide_docs_info_message": true
			}
		}
	},
	"session": {
		"trust_all_worktrees": false
	},
	"cli_default_open_behavior": "existing_window",
	"ui_font_size": 16,
	"buffer_font_size": 15,
	"theme": {
		"mode": "system",
		"light": "One Light",
		"dark": "One Dark"
	}
}
